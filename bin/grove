#!/usr/bin/env bash
# grove — spawn parallel Claude Code agents in git worktrees, grouped in cmux.
#
# Glue layer over worktrunk (`wt`) + cmux + Claude Code: `grove go <branch>
# <prompt>` creates a worktree and opens a cmux workspace running Claude on that
# prompt, filed under the repo's sidebar group (anchor = main checkout).
#
# https://github.com/jlopez/grove
set -euo pipefail

GROVE_VERSION="0.1.0"

# ---- output helpers ---------------------------------------------------------
if [ -t 2 ]; then
  _c_red=$'\033[31m'; _c_grn=$'\033[32m'; _c_ylw=$'\033[33m'
  _c_dim=$'\033[2m'; _c_bld=$'\033[1m'; _c_rst=$'\033[0m'
else
  _c_red=; _c_grn=; _c_ylw=; _c_dim=; _c_bld=; _c_rst=
fi
err()  { printf '%sgrove:%s %s\n' "$_c_red" "$_c_rst" "$*" >&2; }
info() { printf '%sgrove:%s %s\n' "$_c_grn" "$_c_rst" "$*" >&2; }
warn() { printf '%sgrove:%s %s\n' "$_c_ylw" "$_c_rst" "$*" >&2; }
die()  { err "$*"; exit 1; }

# ---- cmux binary discovery --------------------------------------------------
grove_cmux() {
  if [ -n "${GROVE_CMUX:-}" ]; then echo "$GROVE_CMUX"; return; fi
  if command -v cmux >/dev/null 2>&1; then command -v cmux; return; fi
  local app="/Applications/cmux.app/Contents/Resources/bin/cmux"
  [ -x "$app" ] && { echo "$app"; return; }
  return 1
}

# ---- repo identity ----------------------------------------------------------
# Sets: REPO (name) and REPO_PATH (main-checkout dir) — the group's stable
# identity, used for the cmux group name and the deterministic color; and
# WORKTREE_ROOT — the root of the worktree grove was invoked from, which is
# where .grove.json is read/written (so styling is committable on your branch
# and takes effect immediately, instead of dirtying the main checkout).
grove_repo_identity() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "not inside a git repository"
  local common
  common=$(git rev-parse --git-common-dir)
  # Absolutize (git may print a relative .git path) and strip trailing /.git
  common=$(cd "$common" && pwd)
  REPO_PATH=$(dirname "$common")
  REPO=$(basename "$REPO_PATH")
  WORKTREE_ROOT=$(git rev-parse --show-toplevel)
}

# ---- layered config store ---------------------------------------------------
# A single resolver all of grove reads through. Layers, low → high precedence:
#   1. ${XDG_CONFIG_HOME:-~/.config}/grove/config.json  — machine-wide defaults
#   2. <repo-root>/.grove.json                          — committed, repo-shared
#   3. <repo-root>/.grove.local.json                    — gitignored, personal
#   4. a per-keypath ENV_VAR                            — only where a caller opts in
# Files are deep-merged with jq's `*`, which recurses into objects and *replaces*
# arrays/scalars — exactly last-layer-wins per key. The env override (highest
# precedence) is applied per keypath at read time; there is no central registry —
# call sites pass the ENV_VAR they honor (see grove_config_get).
GROVE_CONFIG_JSON='{}'

# grove_config_load <repo-root> — merge the present config files (layers 1-3,
# rooted at <repo-root> for the repo-local files) into GROVE_CONFIG_JSON. Missing
# files are skipped; a file that isn't valid JSON is warned about and skipped
# (matching the defensive read it replaces), so one bad layer never breaks reads.
grove_config_load() {
  local root="$1" f
  local xdg="${XDG_CONFIG_HOME:-$HOME/.config}/grove/config.json"
  local present=()
  for f in "$xdg" "$root/.grove.json" "$root/.grove.local.json"; do
    [ -f "$f" ] || continue
    if jq -e . "$f" >/dev/null 2>&1; then
      present+=("$f")
    else
      warn "$f is not valid JSON — skipping that config layer"
    fi
  done
  if [ ${#present[@]} -eq 0 ]; then
    GROVE_CONFIG_JSON='{}'
  else
    GROVE_CONFIG_JSON=$(jq -s 'reduce .[] as $x ({}; . * $x)' "${present[@]}") \
      || GROVE_CONFIG_JSON='{}'
  fi
}

# grove_config_get <keypath> [ENV_VAR] — print the scalar at <keypath> from the
# loaded config. The keypath is dotted to descend into nested objects (e.g.
# "color", "agent.command"); a key may not itself contain a literal ".". If
# ENV_VAR is given AND set to a non-empty value it wins (the per-keypath
# override). Absent → "". Booleans/numbers are stringified; objects/arrays read
# as "" (use _get_array).
grove_config_get() {
  local keypath="$1" envvar="${2:-}"
  if [ -n "$envvar" ]; then
    local ev="${!envvar:-}"
    [ -n "$ev" ] && { printf '%s\n' "$ev"; return; }
  fi
  printf '%s' "$GROVE_CONFIG_JSON" | jq -r --arg kp "$keypath" '
    getpath($kp | split(".")) as $v
    | if   $v == null          then ""
      elif ($v|type)=="string" then $v
      elif ($v|type)=="object" or ($v|type)=="array" then ""
      else ($v|tostring) end'
}

# grove_config_get_array <keypath> — print each element of the array at <keypath>
# on its own line, for `mapfile -t`. Absent or non-array → nothing.
grove_config_get_array() {
  # `try` so a wrong-typed intermediate ({"sync": "x"}) degrades to "nothing
  # configured" instead of dying with a raw jq error under set -e.
  printf '%s' "$GROVE_CONFIG_JSON" | jq -r --arg kp "$1" '
    (try getpath($kp | split(".")) catch null) as $v
    | if ($v|type)=="array" then $v[] | tostring else empty end'
}

# grove_prompt_tmpfile <prompt> — write <prompt> to a private temp file (mktemp
# under $TMPDIR — never inside the worktree, which must stay clean for
# `wt remove`) and print its path. The launch line built around it deletes the
# file on read, so it never outlives the hand-off.
grove_prompt_tmpfile() {
  local f
  f=$(mktemp "${TMPDIR:-/tmp}/grove-prompt.XXXXXX") || return 1
  printf '%s' "$1" > "$f" || return 1
  printf '%s' "$f"
}

# grove_build_launch [prompt-file] — print the shell command cmux types into a
# new workspace, from the loaded config: agent.command (GROVE_COMMAND overrides;
# default claude) then the agent.args array, each %q-quoted. With a prompt file,
# the typed line reads and reclaims it, then hands the content to the agent as a
# single initial-prompt argument:
#   p=$(cat -- <file>) && rm -f -- <file> && <cmd> <args...> "$p"
# cmux *types* this line into a pty whose canonical-mode input buffer caps a
# line at ~1KB (issue #26) — routing the prompt through a file keeps the typed
# line short and length-invariant, so prompt size can never truncate the launch.
# Reads GROVE_CONFIG_JSON, so callers must grove_config_load first.
grove_build_launch() {
  local pfile="${1:-}" cmd launch a
  local args=()
  cmd=$(grove_config_get "agent.command" GROVE_COMMAND); cmd=${cmd:-claude}
  mapfile -t args < <(grove_config_get_array "agent.args")
  launch=$(printf '%q' "$cmd")
  for a in ${args[@]+"${args[@]}"}; do launch+=" $(printf '%q' "$a")"; done
  if [ -n "$pfile" ]; then
    local qf; qf=$(printf '%q' "$pfile")
    launch="p=\$(cat -- $qf) && rm -f -- $qf && $launch \"\$p\""
  fi
  printf '%s' "$launch"
}

# ---- synced untracked paths -------------------------------------------------
# `sync.paths` is an allow-list of gitignored files/dirs (.env & friends) that
# every worktree needs but git never carries: `grove go` copies them from the
# main checkout into the worktree, and `grove rm` refuses to tear the worktree
# down while one of them differs from the main checkout — so a secret written
# only inside the worktree isn't deleted unseen. Three deliberate rules:
#   * an existing destination is never overwritten — the worktree's own copy
#     always wins, so `grove go` on a reused worktree fills gaps, never clobbers;
#   * only *gitignored* paths are synced — anything else (tracked, or merely
#     untracked) would leave the worktree dirty in git's eyes and make
#     `wt remove` refuse, turning a convenience into a teardown blocker;
#   * the rm-side check is stateless: it compares against the main checkout
#     rather than a hash recorded at copy time, so there's no state file whose
#     lifecycle to manage, and "main rotated its .env" also surfaces as
#     divergence — which is exactly what you want to see before deleting.
# This is deliberately *not* `wt step copy-ignored` (deny-list, all-or-nothing:
# it would drag node_modules/), and worktrunk has nowhere to hang the rm-side
# guard — grove owns both ends of the lifecycle, so the pair lives here.

# grove_sync_path_ok <path> — true if <path> is a safe repo-relative subpath
# (no absolute paths, no `..` escape out of the worktree).
grove_sync_path_ok() {
  case "$1" in
    ''|/*)                return 1 ;;
    ..|../*|*/..|*/../*)  return 1 ;;
    -*)                   return 1 ;;   # would be read as an option by jq/cp/git
  esac
  return 0
}

# grove_sync_copy <src-root> <dst-root> — copy every configured sync.path that
# is missing under <dst-root> from <src-root>. Missing sources, tracked paths
# and unsafe entries are reported and skipped, never fatal: a fresh clone
# legitimately has no .env, and a half-synced worktree still beats no worktree.
# Reads GROVE_CONFIG_JSON, so callers must grove_config_load first.
grove_sync_copy() {
  local src="$1" dst="$2" p
  local paths=() copied=() missing=() tracked=() unignored=()
  paths=(${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"})
  [ ${#paths[@]} -gt 0 ] || return 0
  for p in "${paths[@]}"; do
    if ! grove_sync_path_ok "$p"; then
      warn "sync.paths: ignoring '$p' — must be a relative path inside the repo"
      continue
    fi
    [ -e "$src/$p" ] || { missing+=("$p"); continue; }
    # Tracked and merely-untracked are both disqualifying (a copied untracked
    # file makes the worktree dirty just as surely), but they're different
    # mistakes, so they're diagnosed separately. `ls-files <path>` also answers
    # for directories: it lists any tracked file underneath.
    [ -n "$(git -C "$src" ls-files -- "$p" 2>/dev/null)" ] && { tracked+=("$p"); continue; }
    git -C "$src" check-ignore -q -- "$p" 2>/dev/null || { unignored+=("$p"); continue; }
    [ -e "$dst/$p" ] && continue          # never overwrite — the worktree's copy wins
    mkdir -p -- "$(dirname -- "$dst/$p")" 2>/dev/null \
      || { warn "sync.paths: could not create the parent directory for '$p'"; continue; }
    if cp -Rp -- "$src/$p" "$dst/$p" 2>/dev/null; then
      copied+=("$p")
      # cp -Rp copies a symlink *as* a symlink, which is the right call (a
      # symlinked .env is a deliberate "share one file" setup, and materializing
      # a second copy would defeat it). But a *relative* link resolves against a
      # different depth here than in the main checkout, so it can land dangling.
      [ -L "$dst/$p" ] && [ ! -e "$dst/$p" ] \
        && warn "sync.paths: '$p' is a symlink that doesn't resolve inside the worktree"
      : 
    else
      warn "sync.paths: could not copy '$p' from the main checkout"
    fi
  done
  [ ${#copied[@]}  -gt 0 ] && info "synced from the main checkout: ${copied[*]}"
  [ ${#missing[@]} -gt 0 ] && warn "sync.paths absent from the main checkout (skipped): ${missing[*]}"
  [ ${#tracked[@]} -gt 0 ] && warn "sync.paths tracked by git (skipped — git already carries them): ${tracked[*]}"
  [ ${#unignored[@]} -gt 0 ] && warn "sync.paths not gitignored (skipped — copying would leave the worktree dirty and block 'wt remove'): ${unignored[*]}"
  return 0
}

# ---- dotenv-aware comparison and merge --------------------------------------
# `.env` is the overwhelmingly common sync.path, and it isn't a blob: it's a set
# of keys. Two checkouts that each added their own key have no conflict, they
# have a union — so when both sides of a divergence parse as dotenv, grove merges
# the key sets instead of reporting a wall of diff, and only a key whose *value*
# differs is a real conflict. The parse is deliberately strict: anything that
# isn't blank / `# comment` / `[export ]KEY=VALUE` (multi-line values, JSON,
# binary, a symlink) falls back to the old "they differ, go look" path. The merge
# is a convenience for the shape it recognizes, never a guess about a file it
# doesn't.

GROVE_DOTENV_KEYS=()
# Associative arrays are bash 4+, as is the `mapfile` grove already relies on.
# Guarded so the script still *loads* under macOS's system bash 3.2 (`grove
# version` keeps working); main() refuses the run with a real message instead.
if [ "${BASH_VERSINFO[0]:-0}" -ge 4 ]; then
  declare -A GROVE_DOTENV_VAL=()
  declare -A GROVE_DOTENV_LINE=()
fi

# grove_dotenv_norm <raw-value> — the value as a loader would see it: surrounding
# whitespace dropped, one layer of matching quotes stripped. So `KEY=foo`,
# `KEY="foo"` and `KEY='foo'` are the same value and not a conflict — quoting
# style is exactly the kind of difference two hands introduce independently.
grove_dotenv_norm() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"                 # ltrim
  v="${v%"${v##*[![:space:]]}"}"                 # rtrim
  case "$v" in
    '"'*'"') v=${v:1:${#v}-2} ;;
    "'"*"'") v=${v:1:${#v}-2} ;;
  esac
  printf '%s' "$v"
}

# grove_dotenv_scan <file> — parse <file> into GROVE_DOTENV_KEYS (first-seen
# order), GROVE_DOTENV_VAL[key] (normalized) and GROVE_DOTENV_LINE[key] (the
# verbatim source line, so a merge carries the author's own quoting and `export`
# prefix across rather than re-rendering it). Returns 1 unless *every* line is
# blank, a comment or an assignment — a partial parse would merge half a file.
grove_dotenv_scan() {
  local f="$1" line key
  GROVE_DOTENV_KEYS=(); GROVE_DOTENV_VAL=(); GROVE_DOTENV_LINE=()
  [ -L "$f" ] && return 1        # a symlinked .env is a deliberate shared file
  [ -f "$f" ] || return 1
  # NUL means binary, and `read` would silently swallow it — reject outright
  # rather than "parse" a file whose bytes we never saw.
  [ -z "$(LC_ALL=C tr -dc '\000' < "$f" | tr '\000' 'x')" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}                                        # CRLF
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]]; then
      key="${BASH_REMATCH[2]}"
      [ -n "${GROVE_DOTENV_VAL[$key]+x}" ] || GROVE_DOTENV_KEYS+=("$key")
      GROVE_DOTENV_VAL["$key"]=$(grove_dotenv_norm "${BASH_REMATCH[3]}")
      GROVE_DOTENV_LINE["$key"]="$line"
    else
      return 1
    fi
  done < "$f"
  return 0
}

# grove_dotenv_same <a> <b> — both parse as dotenv *and* define the same keys
# with the same values. This is the "differs only in comments, order or quoting"
# case, and it is what lets `grove sync check` (and the `grove rm` guard) pass
# after a merge: the merge appends to each file in place, so the two never become
# byte-identical, but no key — no *secret* — lives on one side only, which is the
# question the guard actually asks.
grove_dotenv_same() {
  local a="$1" b="$2" k n
  local -A a_val=()
  grove_dotenv_scan "$a" || return 1
  for k in ${GROVE_DOTENV_KEYS[@]+"${GROVE_DOTENV_KEYS[@]}"}; do
    a_val["$k"]="${GROVE_DOTENV_VAL[$k]}"
  done
  n=${#a_val[@]}
  grove_dotenv_scan "$b" || return 1
  [ "${#GROVE_DOTENV_KEYS[@]}" = "$n" ] || return 1
  for k in ${GROVE_DOTENV_KEYS[@]+"${GROVE_DOTENV_KEYS[@]}"}; do
    [ -n "${a_val[$k]+x}" ] || return 1
    [ "${a_val[$k]}" = "${GROVE_DOTENV_VAL[$k]}" ] || return 1
  done
  return 0
}

# grove_dotenv_append <file> <line>... — append lines, first repairing a missing
# final newline so the appended key can't glue itself onto the last one.
grove_dotenv_append() {
  local f="$1"; shift
  [ $# -gt 0 ] || return 0
  if [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ]; then printf '\n' >> "$f"; fi
  printf '%s\n' "$@" >> "$f"
}

# grove_dotenv_merge <a> <b> — union the key sets of two dotenv files *in place*.
# Keys only in <a> are appended to <b> and vice versa, verbatim, so each file
# keeps its own order, comments and quoting — a merge never rewrites a line
# someone wrote. A key both sides define with different values is a conflict:
# nothing is written at all (a half-merged .env is worse than an unmerged one)
# and the names land in GROVE_DOTENV_CONFLICTS.
# Exit: 0 merged, 1 conflict, 2 one side isn't dotenv-shaped.
GROVE_DOTENV_CONFLICTS=()
GROVE_DOTENV_CONFLICT_LEN_A=()
GROVE_DOTENV_CONFLICT_LEN_B=()
grove_dotenv_merge() {
  local a="$1" b="$2" k
  local a_keys=() b_keys=() add_a=() add_b=()
  local -A a_val=() a_line=() b_val=() b_line=()
  GROVE_DOTENV_CONFLICTS=(); GROVE_DOTENV_CONFLICT_LEN_A=(); GROVE_DOTENV_CONFLICT_LEN_B=()
  grove_dotenv_scan "$a" || return 2
  a_keys=(${GROVE_DOTENV_KEYS[@]+"${GROVE_DOTENV_KEYS[@]}"})
  for k in ${a_keys[@]+"${a_keys[@]}"}; do
    a_val["$k"]="${GROVE_DOTENV_VAL[$k]}"; a_line["$k"]="${GROVE_DOTENV_LINE[$k]}"
  done
  grove_dotenv_scan "$b" || return 2
  b_keys=(${GROVE_DOTENV_KEYS[@]+"${GROVE_DOTENV_KEYS[@]}"})
  for k in ${b_keys[@]+"${b_keys[@]}"}; do
    b_val["$k"]="${GROVE_DOTENV_VAL[$k]}"; b_line["$k"]="${GROVE_DOTENV_LINE[$k]}"
  done
  for k in ${a_keys[@]+"${a_keys[@]}"}; do
    [ -n "${b_val[$k]+x}" ] || continue
    [ "${a_val[$k]}" = "${b_val[$k]}" ] && continue
    # Lengths, not values: enough to tell "mine is the long one" apart from a
    # typo, without putting either secret on screen. See grove_sync_unit.
    GROVE_DOTENV_CONFLICTS+=("$k")
    GROVE_DOTENV_CONFLICT_LEN_A+=("${#a_val[$k]}")
    GROVE_DOTENV_CONFLICT_LEN_B+=("${#b_val[$k]}")
  done
  [ ${#GROVE_DOTENV_CONFLICTS[@]} -eq 0 ] || return 1
  for k in ${a_keys[@]+"${a_keys[@]}"}; do
    [ -n "${b_val[$k]+x}" ] || add_b+=("${a_line[$k]}")
  done
  for k in ${b_keys[@]+"${b_keys[@]}"}; do
    [ -n "${a_val[$k]+x}" ] || add_a+=("${b_line[$k]}")
  done
  grove_dotenv_append "$b" ${add_b[@]+"${add_b[@]}"}
  grove_dotenv_append "$a" ${add_a[@]+"${add_a[@]}"}
  return 0
}

# grove_sync_resolve_paths <root>... — set GROVE_SYNC_PATHS to the *union* of
# sync.paths as resolved at each <root>, in first-seen order. Every consumer
# below reads that array rather than the config directly.
#
# Why a union and not a choice of root. The layers don't all live in the same
# place: `.grove.json` is committed, so it's branch-scoped and rightly read from
# the worktree you're in — but `.grove.local.json` is *gitignored*, so it can
# only ever exist where it was written (usually the main checkout) and simply
# isn't present in a fresh worktree. Any single root therefore drops a layer:
# rooting at the worktree loses every personal path, rooting at the main
# checkout loses paths a branch just added. And the two errors are not
# symmetric — an extra candidate costs one `git diff` and is skipped when it
# isn't present, while a missing one means `grove rm` deletes a secret it never
# knew to check. So the guard is monotone in candidates, deliberately.
#
# GROVE_CONFIG_JSON is saved and restored: callers (notably `grove go`) still
# need their own root's agent.command/style after this runs.
GROVE_SYNC_PATHS=()
grove_sync_resolve_paths() {
  local saved="$GROVE_CONFIG_JSON" root p seen
  GROVE_SYNC_PATHS=()
  for root in "$@"; do
    [ -d "${root:-}" ] || continue
    grove_config_load "$root"
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      seen=0
      for c in ${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"}; do
        [ "$c" = "$p" ] && seen=1
      done
      [ "$seen" = 0 ] && GROVE_SYNC_PATHS+=("$p")
    done < <(grove_config_get_array "sync.paths")
  done
  GROVE_CONFIG_JSON="$saved"
}

# grove_sync_differs <a> <b> — the single comparison both the guard and the
# lister go through. Exit: 0 same, 1 differs, 2 could-not-compare. The status
# comes from git, never from "did the diff print anything": a `.gitattributes`
# textconv driver, a file↔directory type change, and an unreadable file all make
# git report a difference while printing *nothing*, and a guard that inferred
# "same" from empty output would let `grove rm` delete the only copy of a secret.
# --no-textconv for the same reason — a redacting diff driver must not be able to
# make two different .env files look identical to the guard protecting them.
grove_sync_differs() {
  local rc=0
  git --no-pager diff --no-index --no-ext-diff --no-textconv --quiet \
    -- "$1" "$2" >/dev/null 2>&1 || rc=$?
  # One narrow exception to "bytes decide": two dotenv files with the same keys
  # and the same values differ only in comments, order or quoting — exactly what
  # a key merge leaves behind, and not a secret that exists on one side only. The
  # parse is strict and file-only, so nothing git couldn't read gets here.
  if [ "$rc" = 1 ] && grove_dotenv_same "$1" "$2"; then return 0; fi
  [ "$rc" -le 1 ] && return "$rc"
  return 2                              # git errored — fail closed, never "same"
}

# grove_sync_check <src-root> <dst-root> [quiet] — compare every configured
# sync.path in <dst-root> against <src-root>. Returns 1 if any diverged, 0
# otherwise (including "nothing configured"). Divergence is reported on stderr
# with a colored `git diff` per path — enough to judge "I don't care about that
# one line" and re-run with --force; a non-empty <quiet> prints the one-line
# summary only (the --force path, where the diff would just be noise).
# Reads GROVE_CONFIG_JSON, so callers must grove_config_load first.
grove_sync_check() {
  local src="$1" dst="$2" quiet="${3:-}" p rc diverged=0
  local paths=()
  paths=(${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"})
  [ ${#paths[@]} -gt 0 ] || return 0
  for p in "${paths[@]}"; do
    grove_sync_path_ok "$p" || continue
    [ -e "$dst/$p" ] || continue          # already gone from the worktree → nothing to lose
    if [ ! -e "$src/$p" ]; then
      diverged=1
      warn "sync: ${_c_bld}$p${_c_rst} exists in the worktree but not in the main checkout"
      continue
    fi
    grove_sync_differs "$src/$p" "$dst/$p" && continue
    rc=$?
    diverged=1
    if [ "$rc" = 2 ]; then
      # Fail closed and say why: the point of the guard is that "I couldn't tell"
      # must never be reported as "they match".
      warn "sync: ${_c_bld}$p${_c_rst} could not be compared with the main checkout — refusing to assume it matches"
      continue
    fi
    if [ -n "$quiet" ]; then
      warn "sync: ${_c_bld}$p${_c_rst} differs from the main checkout"
      continue
    fi
    warn "sync: ${_c_bld}$p${_c_rst} differs from the main checkout (- main, + worktree):"
    grove_sync_show_diff "$src/$p" "$dst/$p"
  done
  return $diverged
}

# grove_sync_show_diff <a> <b> — print the colored `git diff --no-index` body for
# a divergence someone already decided *is* one, so this one is allowed to come
# back empty (a type change prints nothing). Truncated, because the point is a
# judgement call ("I don't care about that line"), not a full review.
grove_sync_show_diff() {
  local a="$1" b="$2" color=never max=40 d body
  [ -t 2 ] && color=always
  d=$(git --no-pager diff --no-index --no-ext-diff --no-textconv "--color=$color" \
        -- "$a" "$b" 2>/dev/null) || true
  body=$(grove_sync_diff_body "$d" "$a" "$b")
  if [ -z "$body" ]; then
    printf '    %s(no textual diff — the two are not the same kind of file)%s\n' \
      "$_c_dim" "$_c_rst" >&2
    return 0
  fi
  { printf '%s\n' "$body" | head -n "$max" || true; } >&2
  if [ "$(printf '%s\n' "$body" | wc -l)" -gt "$max" ]; then
    printf '    %s… diff truncated%s\n' "$_c_dim" "$_c_rst" >&2
  fi
  return 0
}

# grove_sync_diff_body <diff> <src-path> <dst-path> — strip git's file headers
# from a `--no-index` diff for display. For a single file the `warn` line above
# already names it, so the headers are pure noise (they carry absolute paths).
# For a *directory* sync.path the diff spans many files, and dropping the headers
# would leave anonymous hunks nobody can act on — so there the `+++` line is
# rewritten to a short path relative to the synced root. Matching is done on a
# color-stripped copy of each line, so printed lines keep their ANSI attributes.
grove_sync_diff_body() {
  local d="$1" srcp="$2" dstp="$3" multi=0
  [ -d "$srcp" ] || [ -d "$dstp" ] && multi=1
  # LC_ALL=C: a diff of a file git judged textual can still carry bytes that
  # aren't valid in the ambient locale, and awk aborts mid-stream on those
  # ("multibyte conversion failure"), mangling the very output the guard exists
  # to show. Byte semantics keep it a pass-through.
  printf '%s\n' "$d" | LC_ALL=C awk -v e=$'\033' -v multi="$multi" \
      -v sp="$srcp/" -v dp="$dstp/" '
    function plain(s) { gsub(e "\\[[0-9;]*m", "", s); return s }
    {
      l = plain($0)
      if (l ~ /^@@ /) {
        # git appends "function context" to a hunk header: the nearest preceding
        # line that looks like a definition. In a .env that is *the line above the
        # change* — i.e. a neighbouring secret, printed verbatim into a terminal
        # that may be screen-shared or logged. Keep the line numbers, drop the rest.
        hdr = l
        if (match(hdr, /^@@[^@]*@@/)) hdr = substr(hdr, RSTART, RLENGTH)
        if (index($0, e) > 0) print e "[36m" hdr e "[m"; else print hdr
        next
      }
      if (l ~ /^Binary files /) {
        name = l; sub(/^Binary files .* and b/, "", name); sub(/ differ$/, "", name)
        idx = index(name, dp); if (idx) name = substr(name, idx + length(dp))
        print (multi && name != "" ? "  " name ": binary files differ" : "  binary files differ")
        next
      }
      if (l ~ /^(old mode |new mode )/) {
        # A mode-only change produces a diff with no hunks at all; filtering
        # these out left an empty body and a message claiming the files were of
        # different kinds. Report the mode change as the content it is.
        m = l; sub(/^(old|new) mode /, "", m)
        if (l ~ /^old mode /) { oldm = m } else { print "  mode changed " oldm " -> " m }
        next
      }
      if (multi && l ~ /^\+\+\+ /) {
        name = l; sub(/^\+\+\+ b/, "", name)
        idx = index(name, dp); if (idx) name = substr(name, idx + length(dp))
        if (name != "" && name != "/dev/null") { print "  " name ":" ; next }
      }
      if (l ~ /^(diff --git |index |--- |\+\+\+ |new file mode |deleted file mode |similarity index |dissimilarity index |rename from |rename to |copy from |copy to )/) next
      print
    }'
}

# ---- bidirectional gap-fill (`grove sync`) ----------------------------------
# `grove go` copies main → worktree, because at spawn time that is the only
# direction that exists. But a path is naturally *born* on the branch that
# introduces it: `grove sync add 260916-book-club/.env` from a feature worktree
# used to print "absent from the main checkout (skipped)" and leave `grove rm`
# demanding --force, because main was assumed to be the origin of every secret
# (#34). It isn't. So bare `grove sync` fills the gap in whichever direction it
# finds it — with the never-overwrite rule intact: a gap is filled, an existing
# file is never clobbered. The only thing that changed is which side may be the
# source.
#
# Why no `grove sync push`. "Present on one side, absent on the other" has
# exactly one safe resolution, so a second verb would only be a second word to
# remember before getting the one outcome you wanted.

GROVE_SYNC_TO_WT=(); GROVE_SYNC_TO_MAIN=(); GROVE_SYNC_MERGED=()
GROVE_SYNC_ABSENT=(); GROVE_SYNC_TRACKED=(); GROVE_SYNC_UNIGNORED=()
GROVE_SYNC_DIVERGED=(); GROVE_SYNC_CONFLICTED=()

# grove_sync_entries <dir-a> <dir-b> — the union of file/symlink entries under
# either directory, relative, first-seen order. A directory sync.path is handled
# **per entry** so it behaves like a bag of files rather than an all-or-nothing
# blob: each entry can be gap-filled (or merged) on its own side.
grove_sync_entries() {
  local d
  for d in "$1" "$2"; do
    [ -d "$d" ] || continue
    # NUL-delimited: a filename may legally contain a newline, and a line-based
    # read would turn one entry into two bogus ones.
    ( cd "$d" 2>/dev/null && find . -mindepth 1 \( -type f -o -type l \) -print0 ) 2>/dev/null
  done
}

# grove_sync_take <src-root> <dst-root> <path> <to_wt|to_main> — copy one missing
# entry across. Same disqualifiers as grove_sync_copy (tracked, not gitignored),
# checked on **both** roots for the ignore rule: the receiving side is the one
# that would be left dirty, and its .gitignore may differ from the sender's since
# the two are on different branches.
grove_sync_take() {
  local src="$1" dst="$2" p="$3" bucket="$4"
  if [ -n "$(git -C "$src" ls-files -- "$p" 2>/dev/null)" ] \
     || [ -n "$(git -C "$dst" ls-files -- "$p" 2>/dev/null)" ]; then
    # Tracked on *either* side. The receiving side matters too: a path git tracks
    # there but that is currently missing from the working tree reads as a gap,
    # and filling it would silently resurrect a file git is managing.
    GROVE_SYNC_TRACKED+=("$p"); return 0
  fi
  if ! git -C "$src" check-ignore -q -- "$p" 2>/dev/null \
     || ! git -C "$dst" check-ignore -q -- "$p" 2>/dev/null; then
    GROVE_SYNC_UNIGNORED+=("$p"); return 0
  fi
  if ! mkdir -p -- "$(dirname -- "$dst/$p")" 2>/dev/null; then
    warn "sync.paths: could not create the parent directory for '$p'"; return 0
  fi
  if ! cp -Rp -- "$src/$p" "$dst/$p" 2>/dev/null; then
    warn "sync.paths: could not copy '$p'"; return 0
  fi
  # cp -Rp keeps a symlink a symlink (deliberate — see grove_sync_copy), but a
  # *relative* link resolves against a different depth on the other side.
  if [ -L "$dst/$p" ] && [ ! -e "$dst/$p" ]; then
    warn "sync.paths: '$p' is a symlink that doesn't resolve on the receiving side"
  fi
  case "$bucket" in
    to_wt)   GROVE_SYNC_TO_WT+=("$p") ;;
    to_main) GROVE_SYNC_TO_MAIN+=("$p") ;;
  esac
  return 0
}

# grove_sync_unit <main> <wt> <path> — resolve one entry, in whichever direction
# it needs. Recurses into a directory present on both sides. Appends to the
# report arrays above; never fatal.
grove_sync_unit() {
  local main="$1" wt="$2" p="$3" rc=0 mrc=0 e i entries=()
  local in_main=0 in_wt=0
  local -A seen_entry=()
  if [ -e "$main/$p" ] || [ -L "$main/$p" ]; then in_main=1; fi
  if [ -e "$wt/$p" ]   || [ -L "$wt/$p" ];   then in_wt=1;   fi

  if [ "$in_main" = 0 ] && [ "$in_wt" = 0 ]; then GROVE_SYNC_ABSENT+=("$p"); return 0; fi
  if [ "$in_wt" = 0 ];   then grove_sync_take "$main" "$wt" "$p" to_wt;   return 0; fi
  if [ "$in_main" = 0 ]; then grove_sync_take "$wt" "$main" "$p" to_main; return 0; fi

  # Both sides present. A directory on both sides is a bag of entries, not a unit.
  if [ -d "$main/$p" ] && [ -d "$wt/$p" ] && [ ! -L "$main/$p" ] && [ ! -L "$wt/$p" ]; then
    while IFS= read -r -d '' e; do
      e=${e#./}
      [ -n "$e" ] || continue
      [ -n "${seen_entry[$e]+x}" ] && continue
      seen_entry["$e"]=1
      entries+=("$p/$e")
    done < <(grove_sync_entries "$main/$p" "$wt/$p")
    for e in ${entries[@]+"${entries[@]}"}; do grove_sync_unit "$main" "$wt" "$e"; done
    return 0
  fi

  grove_sync_differs "$main/$p" "$wt/$p" && return 0
  rc=$?
  if [ "$rc" = 2 ]; then
    warn "sync: ${_c_bld}$p${_c_rst} could not be compared with the main checkout — left alone"
    GROVE_SYNC_DIVERGED+=("$p"); return 0
  fi
  grove_dotenv_merge "$main/$p" "$wt/$p" || mrc=$?
  case "$mrc" in
    0) GROVE_SYNC_MERGED+=("$p") ;;
    1) GROVE_SYNC_CONFLICTED+=("$p")
       # Deliberately *not* the diff. A conflict in a .env is about keys, and the
       # keys are all you need to go reconcile it by hand; printing the two values
       # would spray secrets — the conflicting one and, through git's context
       # lines, the neighbours that agree — into a terminal that may be
       # screen-shared or logged. `grove sync check` still shows the full diff
       # when you ask for it, which is the right place for an explicit choice.
       warn "sync: ${_c_bld}$p${_c_rst} sets these keys differently on the two sides (skipped):"
       for i in "${!GROVE_DOTENV_CONFLICTS[@]}"; do
         printf '    %s%s%s: differs (main %s chars, worktree %s chars)\n' \
           "$_c_bld" "${GROVE_DOTENV_CONFLICTS[$i]}" "$_c_rst" \
           "${GROVE_DOTENV_CONFLICT_LEN_A[$i]}" "${GROVE_DOTENV_CONFLICT_LEN_B[$i]}" >&2
       done
       warn "sync: values are not printed — 'grove sync check' shows the full diff" ;;
    *) GROVE_SYNC_DIVERGED+=("$p") ;;
  esac
  return 0
}

# grove_sync_exchange <main> <wt> — the bare `grove sync` engine: gap-fill every
# configured path in both directions, merging dotenv key sets where both sides
# exist and differ. Returns 1 if any path had conflicting values (that path is
# left untouched; every other path is still processed — a conflict in one secret
# must not stop the other four from being synced).
grove_sync_exchange() {
  local main="$1" wt="$2" p
  local paths=()
  paths=(${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"})
  GROVE_SYNC_TO_WT=(); GROVE_SYNC_TO_MAIN=(); GROVE_SYNC_MERGED=()
  GROVE_SYNC_ABSENT=(); GROVE_SYNC_TRACKED=(); GROVE_SYNC_UNIGNORED=()
  GROVE_SYNC_DIVERGED=(); GROVE_SYNC_CONFLICTED=()
  [ ${#paths[@]} -gt 0 ] || return 0
  for p in "${paths[@]}"; do
    if ! grove_sync_path_ok "$p"; then
      warn "sync.paths: ignoring '$p' — must be a relative path inside the repo"
      continue
    fi
    grove_sync_unit "$main" "$wt" "$p"
  done
  [ ${#GROVE_SYNC_TO_WT[@]}   -gt 0 ] && info "synced from the main checkout: ${GROVE_SYNC_TO_WT[*]}"
  [ ${#GROVE_SYNC_TO_MAIN[@]} -gt 0 ] && info "seeded the main checkout from this worktree: ${GROVE_SYNC_TO_MAIN[*]}"
  [ ${#GROVE_SYNC_MERGED[@]}  -gt 0 ] && info "merged dotenv keys: ${GROVE_SYNC_MERGED[*]}"
  [ ${#GROVE_SYNC_ABSENT[@]}  -gt 0 ] && warn "sync.paths present in neither checkout (skipped): ${GROVE_SYNC_ABSENT[*]}"
  [ ${#GROVE_SYNC_TRACKED[@]} -gt 0 ] && warn "sync.paths tracked by git (skipped — git already carries them): ${GROVE_SYNC_TRACKED[*]}"
  [ ${#GROVE_SYNC_UNIGNORED[@]} -gt 0 ] && warn "sync.paths not gitignored on both sides (skipped — copying would leave a checkout dirty and block 'wt remove'): ${GROVE_SYNC_UNIGNORED[*]}"
  [ ${#GROVE_SYNC_DIVERGED[@]} -gt 0 ] && warn "sync.paths differ on both sides and aren't dotenv (left alone — see 'grove sync check'): ${GROVE_SYNC_DIVERGED[*]}"
  [ ${#GROVE_SYNC_CONFLICTED[@]} -gt 0 ] && return 1
  return 0
}

# grove_sync_list <main> [dst] — print one status row per configured sync.path.
# With <dst> (a worktree that isn't the main checkout) each row also reports the
# worktree's side: in sync / not copied yet / differs. Returns 1 if any path is
# *misconfigured* (unsafe, tracked, not gitignored) — divergence is a state, not
# a config error, so it doesn't set the flag. Shared by `grove sync list` and
# `grove doctor`; reads GROVE_CONFIG_JSON.
grove_sync_list() {
  local main="$1" dst="${2:-}" p rc bad=0
  local paths=()
  paths=(${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"})
  [ ${#paths[@]} -gt 0 ] || return 0
  [ "$dst" = "$main" ] && dst=""
  for p in "${paths[@]}"; do
    if ! grove_sync_path_ok "$p"; then
      printf '  %s✗%s %s %s(must be a relative path inside the repo)%s\n' \
        "$_c_red" "$_c_rst" "$p" "$_c_dim" "$_c_rst"; bad=1
    elif [ -z "$main" ] || [ ! -e "$main/$p" ]; then
      # Absent from main is no longer a dead end: if this worktree has it, the
      # worktree is the source and `grove sync` seeds main from here (#34).
      if [ -n "$dst" ] && { [ -e "$dst/$p" ] || [ -L "$dst/$p" ]; }; then
        printf '  %s!%s %s %s(only in this worktree — run '"'"'grove sync'"'"' to seed the main checkout)%s\n' \
          "$_c_ylw" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
      else
        printf '  %s!%s %s %s(absent from the main checkout — nothing to copy)%s\n' \
          "$_c_ylw" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
      fi
    elif [ -n "$(git -C "$main" ls-files -- "$p" 2>/dev/null)" ]; then
      printf '  %s✗%s %s %s(tracked by git — git already carries it)%s\n' \
        "$_c_red" "$_c_rst" "$p" "$_c_dim" "$_c_rst"; bad=1
    elif ! git -C "$main" check-ignore -q -- "$p" 2>/dev/null; then
      printf '  %s✗%s %s %s(not gitignored — a copy would leave the worktree dirty)%s\n' \
        "$_c_red" "$_c_rst" "$p" "$_c_dim" "$_c_rst"; bad=1
    elif [ -z "$dst" ]; then
      printf '  %s✓%s %s\n' "$_c_grn" "$_c_rst" "$p"
    elif [ ! -e "$dst/$p" ]; then
      printf '  %s!%s %s %s(not in this worktree — run '"'"'grove sync'"'"')%s\n' \
        "$_c_ylw" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
    elif rc=0; grove_sync_differs "$main/$p" "$dst/$p" || rc=$?; [ "$rc" = 0 ]; then
      printf '  %s✓%s %s %s(in sync)%s\n' "$_c_grn" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
    elif [ "$rc" = 2 ]; then
      # Same distinction grove_sync_check makes: "I couldn't tell" is not
      # "they differ", and the two commands must not contradict each other.
      printf '  %s!%s %s %s(could not be compared with the main checkout)%s\n' \
        "$_c_ylw" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
    else
      printf '  %s!%s %s %s(differs from the main checkout — '"'"'grove sync check'"'"')%s\n' \
        "$_c_ylw" "$_c_rst" "$p" "$_c_dim" "$_c_rst"
    fi
  done
  return $bad
}

# grove_sync_write <style-root> <--local?> <add|rm> <path>... — rewrite
# sync.paths in <style-root>/.grove.json (or .grove.local.json with --local),
# preserving every other key in the file. The base list is the *effective*
# (merged) one, not whatever that single file happens to hold: jq's `*` replaces
# arrays, so a .grove.local.json holding only the new path would silently
# supersede the committed list — writing the effective result forward is the
# only shape that means what it looks like.
grove_sync_write() {
  local root="$1" local_layer="$2" op="$3"; shift 3
  local f="$root/.grove.json" base='{}' cur=() out p
  [ -n "$local_layer" ] && f="$root/.grove.local.json"
  # Refuse to touch a file we couldn't parse: `base` would silently stay {} and
  # the write would discard every other key in it (color, icon, agent…).
  # grove_config_load only *skips* a bad layer; overwriting it is another matter.
  if [ -f "$f" ]; then
    jq -e . "$f" >/dev/null 2>&1 \
      || die "$f is not valid JSON — fix it by hand rather than have grove overwrite it"
    base=$(cat "$f")
  fi
  # The base list: for --local, the *effective* one, because jq's `*` replaces
  # arrays — a local layer holding only the new path would silently supersede the
  # committed list. For the committed file the same move would run the layering
  # backwards, promoting personal (.grove.local.json) and machine-wide (XDG)
  # paths into the file everyone shares, so it seeds from the file's own list.
  if [ -n "$local_layer" ]; then
    mapfile -t cur < <(grove_config_get_array "sync.paths")
  else
    mapfile -t cur < <(printf '%s' "$base" | jq -r '
      (.sync? // {} | if type == "object" then .paths else null end) as $v
      | if ($v | type) == "array" then $v[] | tostring else empty end')
  fi
  # Compose the next list in bash so order is preserved — appended at the end,
  # the way a human editing the file would do it.
  local next=()
  case "$op" in
    add) next=(${cur[@]+"${cur[@]}"})
         for p in "$@"; do
           local seen=0 c
           for c in ${next[@]+"${next[@]}"}; do [ "$c" = "$p" ] && seen=1; done
           [ "$seen" = 1 ] && { warn "sync.paths already has '$p'"; continue; }
           next+=("$p")
         done ;;
    rm)  local c keep
         for c in ${cur[@]+"${cur[@]}"}; do
           keep=1
           for p in "$@"; do [ "$c" = "$p" ] && keep=0; done
           [ "$keep" = 1 ] && next+=("$c")
         done
         for p in "$@"; do
           local found=0 c2
           for c2 in ${cur[@]+"${cur[@]}"}; do [ "$c2" = "$p" ] && found=1; done
           [ "$found" = 0 ] && warn "sync.paths has no '$p'"
         done ;;
  esac
  out=$(printf '%s' "$base" | jq --args \
        'if ($ARGS.positional | length) == 0 then (del(.sync.paths) | if (.sync // {}) == {} then del(.sync) else . end)
         else .sync.paths = $ARGS.positional end' \
        -- ${next[@]+"${next[@]}"}) || die "failed to update $f"
  printf '%s\n' "$out" > "$f"
  info "wrote $f"
  grove_config_load "$root"

  # Writing a lower-precedence layer can be a no-op: a higher one replaces the
  # whole array. Re-derive the effective list and say so, rather than reporting
  # "wrote …" for a change that didn't take (an `rm` that silently leaves the
  # path synced is the dangerous direction).
  local eff=() c still=() have
  mapfile -t eff < <(grove_config_get_array "sync.paths")
  for p in "$@"; do
    have=0
    for c in ${eff[@]+"${eff[@]}"}; do [ "$c" = "$p" ] && have=1; done
    case "$op" in
      rm)  [ "$have" = 1 ] && still+=("$p") ;;
      add) [ "$have" = 0 ] && still+=("$p") ;;
    esac
  done
  if [ ${#still[@]} -gt 0 ]; then
    warn "no effect on the resolved config: ${still[*]}"
    warn "(a higher-precedence layer replaces sync.paths — .grove.local.json wins"
    warn " over .grove.json; see 'grove help' for the layer order)"
  fi
}

# ---- group styling ----------------------------------------------------------
# 48-cell OKLCH palette: 24 hues × 2 lightness tiers (L≈0.74 / 0.62, C≈0.13),
# generated offline and gamut-fitted so every cell clears contrast on both light
# and dark sidebars. Perceptually even (OKLCH, not HSL) — only hue/lightness vary.
GROVE_PALETTE=(
  '#ED86A7' '#F18790' '#F28979' '#EE8F63' '#E6964F' '#DA9E3F' '#CBA63A' '#B7AF41'
  '#A0B751' '#86BD67' '#69C27E' '#47C496' '#1DC5AE' '#03C3C3' '#11C0D6' '#2EBBE8'
  '#52B5F4' '#70ADFB' '#8BA6FD' '#A39EF9' '#B897F0' '#CA91E3' '#D98CD2' '#E488BE'
  '#C46183' '#C8626D' '#C86556' '#C56A3E' '#BE7125' '#B37903' '#A48203' '#928A07'
  '#7C9128' '#629742' '#429C5A' '#029E72' '#0F9B89' '#169999' '#0897A9' '#1394BA'
  '#248FCC' '#4C88D3' '#6880D4' '#7F79D1' '#9372C8' '#A36CBC' '#B167AB' '#BC6398'
)

# grove_hash <string> -> short hex digest, stable across macOS/Linux.
grove_hash() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum | cut -c1-8
  elif command -v sha1sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha1sum | cut -c1-8
  else
    printf '%x' "$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  fi
}

# grove_color_for <repo-name> -> deterministic palette hex (same name → same hue).
grove_color_for() {
  local hexh idx
  hexh=$(grove_hash "$1")
  idx=$(( 16#$hexh % ${#GROVE_PALETTE[@]} ))
  printf '%s\n' "${GROVE_PALETTE[$idx]}"
}

# grove_random_color -> a random palette hex (backs `restyle --color random`,
# which stamps the *picked* hex into .grove.json — never the word "random").
grove_random_color() {
  printf '%s\n' "${GROVE_PALETTE[$((RANDOM % ${#GROVE_PALETTE[@]}))]}"
}

# grove_resolve_style <repo> <style-root> — sets STYLE_COLOR / STYLE_ICON.
#   STYLE_COLOR: "#RRGGBB" to apply, or "INHERIT" to clear (let byCwd/settings show).
#   STYLE_ICON:  SF Symbol to apply, or "" to CLEAR (revert to byCwd/default icon).
# Reads the layered config store rooted at <style-root> (see grove_config_load):
# color absent/"auto" → deterministic; "inherit" → clear; "#RRGGBB" → explicit;
# icon absent → clear. Both attributes fully reconcile: dropping a key reverts
# grove's imperative state for it, so persistent styling lives in the config.
grove_resolve_style() {
  local repo="$1" cval="" ival=""
  grove_config_load "$2"
  cval=$(grove_config_get "color")
  ival=$(grove_config_get "icon")
  case "$cval" in
    ''|auto)  STYLE_COLOR=$(grove_color_for "$repo") ;;
    inherit)  STYLE_COLOR="INHERIT" ;;
    '#'[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) STYLE_COLOR="$cval" ;;
    *)        warn "config color '$cval' invalid (want #RRGGBB | auto | inherit) — using deterministic"
              STYLE_COLOR=$(grove_color_for "$repo") ;;
  esac
  STYLE_ICON="$ival"
}

# grove_apply_style <cmux> <group-ref> <repo> <repo-path> — reconcile cmux's
# imperative group style to .grove.json/deterministic. Idempotent; safe to re-run.
grove_apply_style() {
  local cmux="$1" g="$2"
  grove_resolve_style "$3" "$4"
  if [ "$STYLE_COLOR" = "INHERIT" ]; then
    CMUX_QUIET=1 "$cmux" workspace-group set-color "$g" >/dev/null 2>&1 || true
  else
    CMUX_QUIET=1 "$cmux" workspace-group set-color "$g" --hex "$STYLE_COLOR" >/dev/null 2>&1 || true
  fi
  if [ -n "$STYLE_ICON" ]; then
    CMUX_QUIET=1 "$cmux" workspace-group set-icon "$g" --symbol "$STYLE_ICON" >/dev/null 2>&1 || true
  else
    CMUX_QUIET=1 "$cmux" workspace-group set-icon "$g" >/dev/null 2>&1 || true
  fi
}

# grove_write_style <style-root> <color> <icon> — merge into
# <style-root>/.grove.json (created if absent), preserving any other keys.
# Empty color/icon = leave that key untouched; icon "none" = delete the key.
grove_write_style() {
  local f="$1/.grove.json" color="$2" icon="$3" base='{}' out
  [ -f "$f" ] && jq -e . "$f" >/dev/null 2>&1 && base=$(cat "$f")
  out=$(printf '%s' "$base" | jq --arg c "$color" --arg i "$icon" \
        '(if $c != "" then .color = $c else . end)
         | (if   $i == "none" then del(.icon)
            elif  $i != ""     then .icon = $i
            else  . end)') \
    || die "failed to update $f"
  printf '%s\n' "$out" > "$f"
  info "wrote $f"
}

# ---- worktree / cmux resolution ---------------------------------------------
# grove_worktree_path <branch> — print the worktree path worktrunk has for
# <branch>, or nothing if no worktree exists yet. Reads `wt list --format json`.
grove_worktree_path() {
  wt list --format json | jq -r --arg b "$1" \
    '.[] | select(.branch==$b) | .path' | head -1
}

# grove_title_in_group <groups-json> <workspaces-json> <repo> <branch> — exit 0
# iff some member workspace of the cmux group named <repo> is attached to
# <branch>. Boolean face of grove_ref_in_group: attached means the matcher
# finds a ref.
grove_title_in_group() {
  [ -n "$(grove_ref_in_group "$1" "$2" "$3" "$4")" ]
}

# grove_branch_attached <cmux> <repo> <branch> [canon-path] — exit 0 iff a cmux
# workspace in the repo's group is already attached to <branch>. Boolean face of
# grove_attached_workspace_ref; a failed cmux listing yields no ref (exit 1).
grove_branch_attached() {
  [ -n "$(grove_attached_workspace_ref "$@")" ]
}

# grove_ref_in_group <groups-json> <workspaces-json> <repo> <branch> — print the
# ref of the member workspace of cmux group <repo> whose title == <branch> (or
# custom_title, belt-and-suspenders in case title drifts), or nothing. Pure
# (only needs jq): the I/O lives in grove_attached_workspace_ref. Keys on the
# workspace title — grove sets `--name <branch>` at create, so title == branch —
# and is scoped to the repo group's members, so a same-named branch in another
# repo's group never false-matches. Missing `.groups`/`.workspaces`/
# `member_workspace_refs` fall back to `[]` so a shape change fails closed
# (empty output), not on a jq error. `first(...)` is total, not lossy: the
# `grove go` attach-gate guarantees at most one workspace per branch. `// empty`
# prints nothing when none matches, so a missing/renamed tab yields "".
grove_ref_in_group() {
  printf '%s' "$2" | jq -r \
    --argjson groups "$1" --arg repo "$3" --arg branch "$4" '
      [ (($groups.groups // [])[] | select(.name==$repo)) ] as $g
      | ($g[0].member_workspace_refs // []) as $members
      | first((.workspaces // [])[]
              | select((.ref as $r | $members | index($r))
                       and (.title == $branch or .custom_title == $branch))
              | .ref) // empty
    ' 2>/dev/null
}

# grove_group_member_refs <groups-json> <repo> — print the member workspace refs
# of the cmux group named <repo>, one per line. Pure (jq only); unknown group or
# misshapen listings fail closed to nothing.
grove_group_member_refs() {
  printf '%s' "$1" | jq -r --arg n "$2" \
    '(first((.groups // [])[] | select(.name==$n)) // {})
     | (.member_workspace_refs // [])[]' 2>/dev/null
}

# grove_env_ref_in_group <cmux> <groups-json> <repo> <canon-path> — print the
# ref of the member workspace of cmux group <repo> whose stamped
# GROVE_WORKTREE_PATH env equals <canon-path>, or nothing. The env fallback of
# the shared matcher (issue #18): titles are mutable (branch rename, manual tab
# rename) but the worktree *path* survives both — wt keeps the original dir
# name on a branch rename — so the create-time env stamp is the durable key.
# cmux intentionally omits env from `workspace list` (secrets policy), so this
# costs one `workspace env` call per group member — fine on the title-miss
# path, never for hot loops. Empty <canon-path> (no worktree resolved) yields
# nothing without any cmux call; unstamped members (legacy, UI-created, or
# adopted workspaces — env is create-time-only) and failed env reads are
# skipped, so both cases degrade to today's fail-safe no-match.
grove_env_ref_in_group() {
  local cmux="$1" groups="$2" repo="$3" path="$4" ref envjson wpath
  [ -n "$path" ] || return 0
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    # </dev/null: the call must not inherit the loop's ref stream as stdin — a
    # stdin-draining cmux would silently truncate the sweep to its first member.
    envjson=$(CMUX_QUIET=1 "$cmux" workspace env "$ref" --json 2>/dev/null </dev/null) || continue
    wpath=$(printf '%s' "$envjson" \
            | jq -r '.env.GROVE_WORKTREE_PATH // empty' 2>/dev/null) || continue
    if [ "$wpath" = "$path" ]; then
      printf '%s\n' "$ref"
      return 0
    fi
  done < <(grove_group_member_refs "$groups" "$repo")
  return 0
}

# grove_workspace_for <cmux> <groups-json> <workspaces-json> <repo> <branch>
# <canon-path> — the shared matcher (issue #18), used by the `grove go` attach
# gate and `grove rm`'s close-target lookup. Print the ref of the repo-group
# workspace attached to <branch>, or nothing:
#   1. title match first (pure, zero extra cmux calls — under the attach-gate
#      invariant a title hit is always correct);
#   2. on a miss, the env sweep keyed on the stamped GROVE_WORKTREE_PATH;
#   3. both missing → empty, i.e. today's fail-safe behavior — permanently
#      covers legacy/UI-created/adopted workspaces, which carry no stamp.
grove_workspace_for() {
  local ref
  ref=$(grove_ref_in_group "$2" "$3" "$4" "$5")
  [ -n "$ref" ] || ref=$(grove_env_ref_in_group "$1" "$2" "$4" "$6")
  printf '%s' "$ref"
}

# grove_attached_workspace_ref <cmux> <repo> <branch> [canon-path] — print the
# ref of the cmux workspace in the repo's group attached to <branch>, or
# nothing. Fetches the two listings, then delegates to the shared matcher
# (title first, env-stamp fallback when a canon-path is given).
grove_attached_workspace_ref() {
  local cmux="$1" repo="$2" branch="$3" path="${4:-}" groups workspaces
  groups=$(CMUX_QUIET=1 "$cmux" workspace-group list --json 2>/dev/null)   || return 1
  workspaces=$(CMUX_QUIET=1 "$cmux" workspace list --json 2>/dev/null)     || return 1
  grove_workspace_for "$cmux" "$groups" "$workspaces" "$repo" "$branch" "$path"
}

# grove_orphan_candidates <groups-json> <workspaces-json> — print one
# "ref<TAB>current_directory" line per workspace that belongs to NO group
# (neither a member nor an anchor of any group — anchors also appear in
# member_workspace_refs, but both are checked belt-and-suspenders). Pure (only
# needs jq) so it's unit-testable without cmux; the path filtering — which needs
# the filesystem to canonicalize — lives in grove_adopt_orphans. Missing keys
# fall back to []/"" and malformed listings die inside jq, so a shape change
# fails closed (empty output → nothing adopted), never on a bash error.
grove_orphan_candidates() {
  printf '%s' "$2" | jq -r --argjson groups "$1" '
    [ ($groups.groups // [])[]
      | (.member_workspace_refs // [])[], (.anchor_workspace_ref // empty)
    ] as $grouped
    | (.workspaces // [])[]
    | select(.ref as $r | $grouped | index($r) | not)
    | [.ref, (.current_directory // "")] | @tsv
  ' 2>/dev/null
}

# grove_adopt_orphans <cmux> <repo> <gid> <canon-repo> — self-heal after a group
# dissolution (issue #23). Closing a group's anchor tab dissolves the group but
# its member workspaces survive UNGROUPED; the next `grove go` recreates the
# group yet only attaches the workspace it just spawned (the attach matcher is
# deliberately group-scoped), stranding the rest forever. So after the group is
# ensured, sweep: any workspace in no group whose current_directory canonicalizes
# (pwd -P, as the primary-checkout guards do) to one of THIS repo's linked
# worktrees — per `wt list`, main checkout excluded (that's the header's job) —
# is re-attached. Conservative and idempotent by construction: a workspace in
# any group is never touched, other repos' paths never match, and every failure
# (cmux/wt listing, vanished directory) degrades to "adopt nothing".
grove_adopt_orphans() {
  local cmux="$1" repo="$2" gid="$3" canon_repo="$4"
  local groups workspaces wt_paths p canon
  groups=$(CMUX_QUIET=1 "$cmux" workspace-group list --json 2>/dev/null)  || return 0
  workspaces=$(CMUX_QUIET=1 "$cmux" workspace list --json 2>/dev/null)    || return 0
  wt_paths=$(wt list --format json 2>/dev/null | jq -r '.[].path' 2>/dev/null) || return 0
  # Canonical paths of this repo's linked worktrees (main checkout excluded).
  local paths=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    canon=$(cd "$p" 2>/dev/null && pwd -P) || continue
    [ "$canon" != "$canon_repo" ] || continue
    paths+=("$canon")
  done <<<"$wt_paths"
  [ ${#paths[@]} -gt 0 ] || return 0
  local ref dir
  while IFS=$'\t' read -r ref dir; do
    { [ -n "$ref" ] && [ -n "$dir" ]; } || continue
    canon=$(cd "$dir" 2>/dev/null && pwd -P) || continue
    for p in "${paths[@]}"; do
      [ "$canon" = "$p" ] || continue
      if CMUX_QUIET=1 "$cmux" workspace-group add --group "$gid" --workspace "$ref" >/dev/null 2>&1 </dev/null; then
        info "adopted orphaned workspace ${_c_bld}$ref${_c_rst} into group '$repo'"
      else
        warn "could not adopt orphaned workspace $ref into group '$repo'"
      fi
      break
    done
  done < <(grove_orphan_candidates "$groups" "$workspaces")
}

# grove_group_ref <groups-json> <repo> — print the ref of the cmux group named
# <repo>, or nothing. Pure (jq only); missing/misshapen keys fail closed to "".
grove_group_ref() {
  printf '%s' "$1" | jq -r --arg n "$2" \
    'first((.groups // [])[] | select(.name==$n) | .ref) // empty' 2>/dev/null
}

# grove_group_anchor_ref <groups-json> <repo> — print the anchor workspace ref of
# the cmux group named <repo>, or nothing. The anchor IS the group header: per
# the cmux contract, closing it dissolves the group (members survive, ungrouped),
# which is why grove rm must never close a workspace while it still anchors its
# group (issue #22).
grove_group_anchor_ref() {
  printf '%s' "$1" | jq -r --arg n "$2" \
    'first((.groups // [])[] | select(.name==$n) | .anchor_workspace_ref) // empty' 2>/dev/null
}

# grove_member_at_cwd <groups-json> <workspaces-json> <repo> <cwd> <skip-ref> —
# print the ref of a member workspace of cmux group <repo> whose
# current_directory is exactly <cwd>, never <skip-ref> (the tab about to close).
# Pure; finds the repo-header workspace when re-anchoring. Exact string compare
# is fine: a miss just means a fresh header gets created, never a wrong anchor.
grove_member_at_cwd() {
  printf '%s' "$2" | jq -r \
    --argjson groups "$1" --arg repo "$3" --arg cwd "$4" --arg skip "$5" '
      [ (($groups.groups // [])[] | select(.name==$repo)) ] as $g
      | ($g[0].member_workspace_refs // []) as $members
      | first((.workspaces // [])[]
              | select((.ref as $r | $members | index($r))
                       and .current_directory == $cwd
                       and .ref != $skip)
              | .ref) // empty
    ' 2>/dev/null
}

# grove_reanchor_group <cmux> <groups-json> <workspaces-json> <repo> <repo-path>
# <avoid-ref> — re-anchor the repo's cmux group onto the repo-header workspace at
# the main checkout (mirroring how `grove go` anchors groups at creation), so
# closing <avoid-ref> can no longer dissolve the group. Prefers a member already
# at the main checkout; otherwise creates the header workspace and files it under
# the group. Exit 0 only when a fresh listing confirms the anchor actually moved.
grove_reanchor_group() {
  local cmux="$1" groups="$2" workspaces="$3" repo="$4" repo_path="$5" avoid="$6"
  local gid hdr
  gid=$(grove_group_ref "$groups" "$repo")
  [ -n "$gid" ] || return 1
  hdr=$(grove_member_at_cwd "$groups" "$workspaces" "$repo" "$repo_path" "$avoid")
  if [ -z "$hdr" ]; then
    hdr=$(CMUX_QUIET=1 "$cmux" workspace create \
            --cwd "$repo_path" --name "$repo" --json 2>/dev/null \
          | jq -r '.workspace_ref // empty')
    { [ -n "$hdr" ] && [ "$hdr" != "null" ]; } || return 1
    CMUX_QUIET=1 "$cmux" workspace-group add --group "$gid" --workspace "$hdr" >/dev/null 2>&1 \
      || return 1
  fi
  CMUX_QUIET=1 "$cmux" workspace-group set-anchor --group "$gid" --workspace "$hdr" >/dev/null 2>&1 \
    || return 1
  groups=$(CMUX_QUIET=1 "$cmux" workspace-group list --json 2>/dev/null) || return 1
  [ "$(grove_group_anchor_ref "$groups" "$repo")" = "$hdr" ]
}

# grove_resolve_base <opt-base> <opt-no-fetch> — set GROVE_BASE_ARGS (an array) to
# the `--base <ref>` worktrunk should branch a brand-new worktree from, applying
# freshness-by-default (issue #14). worktrunk's `wt switch -c` branches from the
# *local* default, which goes stale after a squash-merge that the local default
# never pulled; grove owns the fetch because wt's earliest hook runs after the
# worktree exists — too late to pick a base. Precedence:
#   1. explicit --base <ref> (escape hatch) wins, no fetch.
#   2. else detect the default branch from origin/HEAD (no network); unless
#      --no-fetch, fetch just that one ref and branch from fresh origin/<def>.
# Every failure degrades gracefully — never hard-fails: no origin/HEAD → leave
# GROVE_BASE_ARGS empty (wt picks its own default); fetch failure or --no-fetch →
# warn and branch from the local default (may be stale).
grove_resolve_base() {
  local opt_base="$1" opt_no_fetch="$2" def
  GROVE_BASE_ARGS=()
  if [ -n "$opt_base" ]; then
    GROVE_BASE_ARGS=(--base "$opt_base")
    return
  fi
  def=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null) || def=""
  def=${def#origin/}
  if [ -z "$def" ]; then
    warn "no origin/HEAD set — letting worktrunk pick the base (set it with 'git remote set-head origin -a')"
    return
  fi
  if [ -n "$opt_no_fetch" ]; then
    info "--no-fetch: branching '$def' without refreshing (may be stale)"
    GROVE_BASE_ARGS=(--base "$def")
  elif git fetch origin "$def" --quiet 2>/dev/null; then
    GROVE_BASE_ARGS=(--base "origin/$def")
  else
    warn "could not fetch origin/$def — branching from local '$def' (may be stale)"
    GROVE_BASE_ARGS=(--base "$def")
  fi
}

# =============================================================================
# grove go [--base <ref>] [--no-fetch] <branch> [prompt...]
# =============================================================================
grove_go() {
  # First real flag parsing in `grove go`: --base/--no-fetch are consumed before
  # the <branch> positional; the first non-option (or `--`) ends option parsing,
  # so a prompt that itself starts with `-` still works after the branch.
  local opt_base="" opt_no_fetch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)     [ $# -ge 2 ] || die "grove go: --base needs a ref"; opt_base="$2"; shift 2 ;;
      --base=*)   opt_base="${1#--base=}"; shift ;;
      --no-fetch) opt_no_fetch=1; shift ;;
      -h|--help)  echo "usage: grove go [--base <ref>] [--no-fetch] <branch> [prompt...]"; return 0 ;;
      --)         shift; break ;;
      -*)         die "grove go: unknown option '$1'" ;;
      *)          break ;;
    esac
  done
  [ $# -ge 1 ] || die "usage: grove go [--base <ref>] [--no-fetch] <branch> [prompt...]"
  local branch="$1"; shift
  local prompt="${*:-}"

  command -v wt >/dev/null 2>&1 || die "worktrunk (wt) not found — see 'grove doctor'"
  command -v jq >/dev/null 2>&1 || die "jq not found — see 'grove doctor'"
  local CMUX; CMUX=$(grove_cmux) || die "cmux CLI not found — see 'grove doctor'"

  grove_repo_identity

  # 1. Fail-fast cmux gate (before writing anything): if a workspace in this
  #    repo's group is already attached to <branch>, stop — never spawn a
  #    duplicate. The branch's existing worktree path is resolved first
  #    (read-only `wt list`) so the gate's env fallback (issue #18) can key on
  #    it: a tab whose title drifted (manual rename) no longer defeats the
  #    gate, because its stamped GROVE_WORKTREE_PATH still matches. No worktree
  #    yet → empty key → title-only gate, as before.
  local wtpath canon_gate=""
  wtpath=$(grove_worktree_path "$branch") || die "could not query worktrees (is 'wt' working? see 'grove doctor')"
  if [ -n "$wtpath" ]; then
    canon_gate=$(cd "$wtpath" 2>/dev/null && pwd -P) || canon_gate="$wtpath"
  fi
  if grove_branch_attached "$CMUX" "$REPO" "$branch" "$canon_gate"; then
    die "a workspace is already attached to '$branch' — close it first, or pick another branch"
  fi

  # 2. Resolve-or-create the worktree (git). Three cases, by branch/worktree
  #    existence (see issue #2), keying on the path the gate already resolved.
  #    Worktree exists → reuse its path, no `wt switch`; branch exists but no
  #    worktree → materialize it; neither → create both. `wt switch` fires
  #    worktrunk pre-start hooks (e.g. multi-account).
  if [ -n "$wtpath" ]; then
    info "reusing existing worktree for '$branch'"
  elif git -C "$REPO_PATH" show-ref --verify --quiet "refs/heads/$branch"; then
    info "branch '$branch' exists — materializing its worktree…"
    wt switch "$branch" --no-cd -y \
      || die "could not materialize worktree for existing branch '$branch'"
    wtpath=$(grove_worktree_path "$branch") || die "could not resolve worktree path for '$branch'"
  else
    # G0: brand-new branch. Resolve a fresh base (fetch origin/<def> by default)
    # so the worktree doesn't start from a stale local default (issue #14). G1
    # (materialize) and G2 (reuse) have existing history → no base to choose.
    grove_resolve_base "$opt_base" "$opt_no_fetch"
    info "creating worktree for '$branch'…"
    wt switch -c "$branch" ${GROVE_BASE_ARGS[@]+"${GROVE_BASE_ARGS[@]}"} --no-cd -y \
      || die "worktree creation failed for '$branch'"
    wtpath=$(grove_worktree_path "$branch") || die "could not resolve worktree path for '$branch'"
  fi
  [ -n "$wtpath" ] || die "could not resolve worktree path for '$branch'"

  # 3. Primary-checkout guard: never spawn into the group header (the repo's main
  #    checkout, which grove anchors each group at). Compare canonicalized paths.
  local canon_wt canon_repo
  canon_wt=$(cd "$wtpath" 2>/dev/null && pwd -P) || canon_wt="$wtpath"
  canon_repo=$(cd "$REPO_PATH" 2>/dev/null && pwd -P) || canon_repo="$REPO_PATH"
  [ "$canon_wt" != "$canon_repo" ] \
    || die "'$branch' is the repo's primary checkout — grove targets linked worktrees"

  # 4. Sync the untracked paths git can't carry (sync.paths — .env & friends)
  #    from the main checkout into the worktree, BEFORE the workspace is created
  #    so the agent's very first command already sees them. Existing files are
  #    never overwritten, so a reused worktree (G2) keeps its own.
  grove_config_load "$WORKTREE_ROOT"
  grove_sync_resolve_paths "$WORKTREE_ROOT" "$canon_repo"
  grove_sync_copy "$canon_repo" "$wtpath"

  # 5. Build the command cmux types into the new workspace's shell, from the
  #    layered config (agent.command + agent.args). A non-empty prompt goes
  #    through a temp file the typed line reads-and-reclaims (issue #26) — the
  #    line stays short no matter how long the prompt is; empty prompt keeps
  #    the bare-agent launch.
  local launch pfile=""
  if [ -n "$prompt" ]; then
    pfile=$(grove_prompt_tmpfile "$prompt") || die "could not write prompt temp file"
  fi
  launch=$(grove_build_launch "$pfile")

  # 6. Spawn the worktree workspace (inherits caller's cmux window via CMUX_*
  #    env), stamping grove's identity into the workspace env (issue #18):
  #    GROVE_WORKTREE_PATH is the durable key the env-fallback matcher uses
  #    (titles mutate on branch/tab rename; the canonical worktree path
  #    survives both), GROVE_REPO_PATH/GROVE_VERSION are provenance. Create
  #    time is the only chance — cmux has no post-hoc env setter — and every
  #    shell in the tab inherits the vars (usable by user scripts/hooks).
  local ws
  ws=$(CMUX_QUIET=1 "$CMUX" workspace create \
        --cwd "$wtpath" --name "$branch" --command "$launch" \
        --env "GROVE_WORKTREE_PATH=$canon_wt" \
        --env "GROVE_REPO_PATH=$canon_repo" \
        --env "GROVE_VERSION=$GROVE_VERSION" \
        --json \
        | jq -r '.workspace_ref')
  if ! { [ -n "$ws" ] && [ "$ws" != "null" ]; }; then
    [ -n "$pfile" ] && rm -f -- "$pfile"
    die "cmux workspace create failed"
  fi

  # 7. File under the repo group; create it (anchor = main checkout) on first use.
  local gid
  gid=$(CMUX_QUIET=1 "$CMUX" workspace-group list --json \
        | jq -r --arg n "$REPO" 'first(.groups[] | select(.name==$n) | .ref) // empty')
  if [ -n "$gid" ]; then
    CMUX_QUIET=1 "$CMUX" workspace-group add --group "$gid" --workspace "$ws" >/dev/null
  else
    gid=$(CMUX_QUIET=1 "$CMUX" workspace-group create \
            --name "$REPO" --cwd "$REPO_PATH" --from "$ws" --json | jq -r '.group.ref')
  fi

  # 8. Adopt orphans (issue #23): if this repo's group was dissolved (anchor tab
  #    closed), its surviving workspaces are ungrouped and invisible to the
  #    group-scoped matchers — re-attach any whose cwd is one of this repo's
  #    worktrees, so a `grove go` self-heals the sidebar instead of stranding them.
  { [ -n "$gid" ] && [ "$gid" != "null" ]; } \
    && grove_adopt_orphans "$CMUX" "$REPO" "$gid" "$canon_repo"

  # 9. Reconcile group styling from this worktree's .grove.json (deterministic
  #    color by default).
  { [ -n "$gid" ] && [ "$gid" != "null" ]; } \
    && grove_apply_style "$CMUX" "$gid" "$REPO" "$WORKTREE_ROOT"

  CMUX_QUIET=1 "$CMUX" workspace select "$ws" >/dev/null 2>&1 || true
  info "spawned ${_c_bld}$ws${_c_rst} ($branch) under group '${_c_bld}$REPO${_c_rst}'"
  printf '%s\n' "$wtpath"
}

# =============================================================================
# grove rm [--force] [-D] [--keep-branch] [--reap] [--no-fetch] [<branch>]
# The inverse of `grove go`: close the cmux workspace attached to <branch> and
# remove its worktree. grove owns the workspace↔branch bridge (nobody else knows
# it), so it closes the tab `wt remove`/`wt merge` would otherwise strand; the
# git side is delegated to `wt remove`, which is safe by default — it refuses a
# dirty worktree without --force, and its merged-branch detection is squash-aware
# (six conditions incl. simulated merge + patch-id), superseding issue #15's
# proposed gh-PR-state guard; see "safety model" in docs/design.md. An unmerged
# branch is kept, never deleted, unless -D.
# =============================================================================
grove_rm() {
  local opt_force="" opt_forcedel="" opt_keep="" opt_reap="" opt_no_fetch="" branch=""
  # Unlike `grove go` (whose trailing tokens are the prompt), `grove rm` has no
  # free-form tail — so flags may appear in any position and a second positional
  # is a mistake we reject, rather than silently dropping a post-branch --force
  # (which would then be re-suggested by the failure hint — a confusing loop).
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force)         opt_force=1; shift ;;
      -D|--force-delete)  opt_forcedel=1; shift ;;
      --keep-branch)      opt_keep=1; shift ;;
      --reap)             opt_reap=1; shift ;;
      --no-fetch)         opt_no_fetch=1; shift ;;
      -h|--help)          echo "usage: grove rm [--force] [-D] [--keep-branch] [--reap] [--no-fetch] [<branch>]"; return 0 ;;
      --)            shift
                     while [ $# -gt 0 ]; do
                       [ -z "$branch" ] || die "grove rm: unexpected argument '$1'"
                       branch="$1"; shift
                     done ;;
      -*)            die "grove rm: unknown option '$1'" ;;
      *)             [ -z "$branch" ] || die "grove rm: unexpected argument '$1'"
                     branch="$1"; shift ;;
    esac
  done

  command -v wt >/dev/null 2>&1 || die "worktrunk (wt) not found — see 'grove doctor'"
  command -v jq >/dev/null 2>&1 || die "jq not found — see 'grove doctor'"
  local CMUX; CMUX=$(grove_cmux) || die "cmux CLI not found — see 'grove doctor'"

  grove_repo_identity

  # Default to the current worktree's branch (matches `wt remove`'s "current"
  # default) — so `grove rm` from inside the worktree you're done with just works.
  if [ -z "$branch" ]; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
    { [ -n "$branch" ] && [ "$branch" != "HEAD" ]; } \
      || die "grove rm: no <branch> given and couldn't detect the current branch"
  fi

  # Primary-checkout guard: never tear down the repo's main checkout (the group's
  # anchor/header). Compare canonicalized paths, as `grove go` does. Removing a
  # *member* leaves the group intact; only closing the anchor dissolves it.
  # canon_wt outlives this guard: it's the env-fallback match key for the tab
  # close below, and must be canonicalized NOW — `wt remove` deletes the dir.
  local wtpath canon_wt="" canon_repo
  wtpath=$(grove_worktree_path "$branch") \
    || die "could not query worktrees (is 'wt' working? see 'grove doctor')"
  if [ -n "$wtpath" ]; then
    canon_wt=$(cd "$wtpath" 2>/dev/null && pwd -P) || canon_wt="$wtpath"
    canon_repo=$(cd "$REPO_PATH" 2>/dev/null && pwd -P) || canon_repo="$REPO_PATH"
    [ "$canon_wt" != "$canon_repo" ] \
      || die "'$branch' is the repo's primary checkout — grove rm targets linked worktrees"
  fi

  # 0. Synced-path guard (sync.paths). The worktree is about to be deleted and
  #    .env & friends live only on disk: git can't preserve them, and wt's
  #    dirty-tree refusal can't see them (they're gitignored, so they're never
  #    "dirty"). So diff each configured path against the main checkout and
  #    refuse on divergence, printing the diff — enough to judge "I don't care
  #    about that line" and re-run with --force. --force doesn't silence the
  #    finding, it just downgrades it to a one-line warning: the removal is
  #    still discarding content that exists nowhere else.
  if [ -n "$wtpath" ]; then
    # Candidates come from every root that could name one: the worktree grove
    # was invoked from, the worktree being torn down (a branch may have added a
    # path that isn't merged yet), and the main checkout (the only place the
    # gitignored .grove.local.json can live). Union, never a choice — see
    # grove_sync_resolve_paths for why the guard is monotone.
    grove_config_load "$WORKTREE_ROOT"
    grove_sync_resolve_paths "$WORKTREE_ROOT" "$wtpath" "$canon_repo"
    if ! grove_sync_check "$canon_repo" "$wtpath" "$opt_force"; then
      [ -n "$opt_force" ] \
        || die "synced paths differ from the main checkout (above) — copy what you need, then re-run 'grove rm --force'"
      warn "--force: removing anyway — the divergence above is discarded"
    fi
  fi

  # 1. Remove the worktree (git) FIRST, delegating to wt's safe defaults (it
  #    refuses a dirty tree without --force and deletes the branch only when
  #    merged). Removal must precede the tab close: `grove rm` is often run from
  #    inside the very worktree's own tab, and closing that tab first could kill
  #    grove before `wt remove` ran — the inverse of the command's purpose. wt
  #    renames the worktree out and deletes the branch synchronously (only the
  #    final rm -rf is detached), so this returns once the outcome — success or a
  #    dirty-tree refusal — is known. `-y` skips worktrunk's hook-approval prompts
  #    (as `grove go` does on `wt switch`), so a repo with pre-remove hooks doesn't
  #    hang non-interactively.
  if [ -n "$wtpath" ]; then
    # Freshness — the teardown mirror of issue #14: wt deletes the branch only
    # when its merged-checks say it adds nothing to the default branch, compared
    # against origin/<default> *as last fetched*. Run right after a squash merge
    # (`gh pr merge -sd`), a stale ref makes the just-merged branch look
    # unmerged, so wt would keep it — the branch half of the leak #15 exists to
    # fix. Refresh just that ref first; every failure degrades gracefully (the
    # branch may be kept, never lost).
    if [ -z "$opt_no_fetch" ]; then
      local def
      def=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null) || def=""
      def=${def#origin/}
      if [ -n "$def" ]; then
        git fetch origin "$def" --quiet 2>/dev/null \
          || warn "could not fetch origin/$def — merged-branch detection may be stale"
      fi
    fi
    local rm_args=("$branch" -y)
    [ -n "$opt_force" ]    && rm_args+=(--force)
    [ -n "$opt_forcedel" ] && rm_args+=(--force-delete)
    [ -n "$opt_keep" ]     && rm_args+=(--no-delete-branch)
    [ -n "$opt_reap" ]     && rm_args+=(--reap)
    info "removing worktree for '$branch'…"
    wt remove "${rm_args[@]}" \
      || die "worktree removal failed for '$branch' (dirty tree? re-run 'grove rm --force')"
    info "removed worktree for ${_c_bld}$branch${_c_rst}"
  else
    info "no worktree for '$branch'"
  fi

  # 2. Close the cmux workspace attached to <branch>, if any — LAST, so closing
  #    grove's own tab can't abort the removal above. Shared matcher (issue
  #    #18): title first, then the GROVE_WORKTREE_PATH env stamp — so a tab
  #    whose branch was renamed after `grove go` (the motivating incident: the
  #    title keeps the creation name, but the worktree path survives the
  #    rename) is still found and closed instead of left orphaned. Both
  #    missing → no ref (fails safe), leaving nothing to close.
  local groups workspaces ws
  groups=$(CMUX_QUIET=1 "$CMUX" workspace-group list --json 2>/dev/null) || groups='{}'
  workspaces=$(CMUX_QUIET=1 "$CMUX" workspace list --json 2>/dev/null)   || workspaces='{}'
  ws=$(grove_workspace_for "$CMUX" "$groups" "$workspaces" "$REPO" "$branch" "$canon_wt")
  if [ -n "$ws" ]; then
    # Anchor guard (issue #22). The primary-checkout guard above assumes the
    # group's anchor is the repo-header workspace at the main checkout — true for
    # grove-created groups, but a legacy or UI-created group can be anchored on
    # any member tab, and closing the anchor dissolves the group (orphaning its
    # members, per the cmux contract). If the close target IS the anchor,
    # re-anchor the group to the repo header first; if that fails, refuse to
    # close rather than dissolve the group.
    if [ "$ws" = "$(grove_group_anchor_ref "$groups" "$REPO")" ]; then
      info "workspace $ws anchors group '$REPO' — re-anchoring to the repo header first…"
      if grove_reanchor_group "$CMUX" "$groups" "$workspaces" "$REPO" "$REPO_PATH" "$ws"; then
        info "re-anchored group '${_c_bld}$REPO${_c_rst}' at its main checkout"
      else
        warn "could not re-anchor group '$REPO' — leaving workspace $ws open"
        warn "(closing it now would dissolve the group and orphan its members;"
        warn " re-anchor manually — cmux workspace-group set-anchor — then close the tab)"
        return 0
      fi
    fi
    info "closing workspace ${_c_bld}$ws${_c_rst} ($branch)…"
    CMUX_QUIET=1 "$CMUX" workspace close "$ws" >/dev/null 2>&1 \
      || warn "could not close workspace $ws (already gone?)"
  else
    info "no cmux workspace attached to '$branch'"
  fi
}

# =============================================================================
# grove restyle [--color #RRGGBB|auto|random|inherit] [--icon <sf-symbol>|none]
# Re-apply this repo's group style without spawning an agent. With --color/--icon
# it writes this worktree's .grove.json first (so hand-editing JSON is optional),
# then applies. --color random stamps a random palette hex; --icon none drops it.
# =============================================================================
grove_restyle() {
  local set_color="" set_icon="" color_set=0 icon_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --color) [ $# -ge 2 ] || die "grove restyle: --color needs a value (#RRGGBB | auto | random | inherit)"
               set_color="$2"; color_set=1; shift 2 ;;
      --icon)  [ $# -ge 2 ] || die "grove restyle: --icon needs an SF Symbol name (or 'none')"
               set_icon="$2"; icon_set=1; shift 2 ;;
      -h|--help) echo "usage: grove restyle [--color #RRGGBB|auto|random|inherit] [--icon <sf-symbol>|none]"; return 0 ;;
      *) die "grove restyle: unknown option '$1'" ;;
    esac
  done
  if [ "$color_set" = 1 ]; then
    case "$set_color" in
      auto|random|inherit|'#'[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
      *) die "grove restyle: --color '$set_color' must be #RRGGBB, auto, random, or inherit" ;;
    esac
    # random resolves to a concrete palette hex now, so .grove.json stays stable.
    [ "$set_color" = random ] && set_color=$(grove_random_color)
  fi
  # an empty --icon means "drop the icon"; normalize to the delete sentinel.
  [ "$icon_set" = 1 ] && [ -z "$set_icon" ] && set_icon="none"
  # values to write: "" means "leave this key alone".
  [ "$color_set" = 1 ] || set_color=""
  [ "$icon_set"  = 1 ] || set_icon=""

  command -v jq >/dev/null 2>&1 || die "jq not found — see 'grove doctor'"
  local CMUX; CMUX=$(grove_cmux) || die "cmux CLI not found — see 'grove doctor'"
  grove_repo_identity

  { [ "$color_set" = 1 ] || [ "$icon_set" = 1 ]; } \
    && grove_write_style "$WORKTREE_ROOT" "$set_color" "$set_icon"

  local gid
  gid=$(CMUX_QUIET=1 "$CMUX" workspace-group list --json \
        | jq -r --arg n "$REPO" 'first(.groups[] | select(.name==$n) | .ref) // empty')
  [ -n "$gid" ] || { warn "no cmux group for '$REPO' yet — run 'grove go' first"; return 0; }

  grove_apply_style "$CMUX" "$gid" "$REPO" "$WORKTREE_ROOT"
  info "restyled group '${_c_bld}$REPO${_c_rst}'"
}

# =============================================================================
# grove sync [list|check|add|rm] — the sync.paths verb
# Bare `grove sync` copies the configured untracked paths into *this* worktree —
# `grove go`'s step 4, on demand. It's the case `go` can't cover: you add `.env`
# to the main checkout after spawning five agents, and the attach gate rightly
# refuses to re-run `grove go` for any of them. `check` is `grove rm`'s guard on
# demand (exit 1 on divergence, so it composes into scripts and hooks); `list`
# reports config + worktree state; `add`/`rm` edit the JSON so hand-editing an
# array is optional (mirroring what `restyle --color` does for styling).
# =============================================================================
grove_sync() {
  local sub="${1:-copy}"; [ $# -gt 0 ] && shift
  case "$sub" in
    -h|--help)
      echo "usage: grove sync [list|check|add [--local] <path>...|rm [--local] <path>...]"
      return 0 ;;
    copy|list|check|add|rm) ;;
    -*) die "grove sync: unknown option '$sub'" ;;
    *)  die "grove sync: unknown subcommand '$sub' (list, check, add, rm)" ;;
  esac

  # Reject stray args on the argument-less subcommands before anything else, so
  # a typo can't be masked by an earlier "nothing configured" return. `go`/`rm`/
  # `restyle` all die on unknown arguments too.
  case "$sub" in
    copy|check|list)
      [ $# -eq 0 ] \
        || die "grove sync${sub:+ ${sub/copy/}}: unexpected argument '$1' (paths go to 'add'/'rm')"
      ;;
  esac

  command -v jq >/dev/null 2>&1 || die "jq not found — see 'grove doctor'"
  grove_repo_identity
  grove_config_load "$WORKTREE_ROOT"

  local canon_wt canon_repo
  canon_wt=$(cd "$WORKTREE_ROOT" 2>/dev/null && pwd -P) || canon_wt="$WORKTREE_ROOT"
  canon_repo=$(cd "$REPO_PATH" 2>/dev/null && pwd -P)   || canon_repo="$REPO_PATH"
  # Same union every other consumer sees, so `grove sync` can't report on a
  # different set of paths than `grove go`/`grove rm` act on.
  grove_sync_resolve_paths "$WORKTREE_ROOT" "$canon_repo"

  local n=${#GROVE_SYNC_PATHS[@]}
  if [ "$n" = 0 ] && [ "$sub" != add ] && [ "$sub" != rm ]; then
    warn "no sync.paths configured — add one with 'grove sync add <path>'"
    return 0
  fi

  case "$sub" in
    copy|check)
      # Both compare/copy main → this worktree, so neither means anything when
      # run *in* the main checkout: there's no destination distinct from source.
      [ "$canon_wt" != "$canon_repo" ] \
        || die "grove sync $sub: run this from a linked worktree, not the main checkout"
      ;;
  esac

  case "$sub" in
    copy)  local xrc=0
           grove_sync_exchange "$canon_repo" "$canon_wt" || xrc=$?
           if [ "$xrc" != 0 ]; then
             err "sync incomplete — reconcile the conflicting keys above by hand, then re-run"
             return 1
           fi
           info "sync complete for ${_c_bld}$(basename "$canon_wt")${_c_rst}" ;;
    check) if grove_sync_check "$canon_repo" "$canon_wt"; then
             info "all synced paths match the main checkout"
           else
             err "synced paths differ from the main checkout (above)"
             return 1
           fi ;;
    list)  printf '%ssync.paths%s %s(from %s)%s\n' \
             "$_c_bld" "$_c_rst" "$_c_dim" "$canon_repo" "$_c_rst"
           grove_sync_list "$canon_repo" "$canon_wt" || return 1 ;;
    add|rm)
      local local_layer="" args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --local) local_layer=1; shift ;;
          --)      shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
          -*)      die "grove sync $sub: unknown option '$1'" ;;
          *)       args+=("$1"); shift ;;
        esac
      done
      [ ${#args[@]} -gt 0 ] || die "usage: grove sync $sub [--local] <path>..."
      if [ "$sub" = add ]; then
        # Validate before writing: a tracked path is unambiguously a mistake
        # (git already carries it) and is refused; the softer problems warn but
        # still write — you may be about to add the .gitignore line, or create
        # the file next. Paths are normalized against the repo root so
        # `grove sync add ./.env` from a subdir does the obvious thing.
        local p
        for p in "${args[@]}"; do
          grove_sync_path_ok "$p" \
            || die "grove sync add: '$p' must be a relative path inside the repo"
          [ -n "$(git -C "$canon_repo" ls-files -- "$p" 2>/dev/null)" ] \
            && die "grove sync add: '$p' is tracked by git — git already carries it into every worktree"
          [ -n "$(git -C "$canon_wt" ls-files -- "$p" 2>/dev/null)" ] \
            && die "grove sync add: '$p' is tracked by git on this branch — git already carries it"
          git -C "$canon_repo" check-ignore -q -- "$p" 2>/dev/null \
            || warn "'$p' is not gitignored — copying it would leave the worktree dirty and block 'wt remove'"
          # Either side may be the origin now (#34), so "nothing to copy" is only
          # true when the path exists in neither.
          { [ -e "$canon_repo/$p" ] || [ -e "$canon_wt/$p" ]; } \
            || warn "'$p' exists in neither checkout yet — nothing to copy until it does"
        done
      fi
      grove_sync_write "$WORKTREE_ROOT" "$local_layer" "$sub" "${args[@]}"
      grove_sync_resolve_paths "$WORKTREE_ROOT" "$canon_repo"
      # `add` seeds immediately, so the common case ("this branch was born with a
      # .env") is one command rather than add-then-sync. Only the paths just
      # added, and only when there's a worktree distinct from the main checkout.
      local arc=0
      if [ "$sub" = add ] && [ "$canon_wt" != "$canon_repo" ]; then
        local eff=() c q
        eff=(${GROVE_SYNC_PATHS[@]+"${GROVE_SYNC_PATHS[@]}"})
        GROVE_SYNC_PATHS=()
        for q in "${args[@]}"; do
          for c in ${eff[@]+"${eff[@]}"}; do
            [ "$c" = "$q" ] && { GROVE_SYNC_PATHS+=("$q"); break; }
          done
        done
        grove_sync_exchange "$canon_repo" "$canon_wt" || arc=$?
        GROVE_SYNC_PATHS=(${eff[@]+"${eff[@]}"})
      fi
      printf '%ssync.paths%s %s(from %s)%s\n' \
        "$_c_bld" "$_c_rst" "$_c_dim" "$canon_repo" "$_c_rst"
      grove_sync_list "$canon_repo" "$canon_wt" || true
      if [ "$arc" != 0 ]; then
        err "sync incomplete — reconcile the conflicting keys above by hand, then re-run 'grove sync'"
        return 1
      fi ;;
  esac
}

# =============================================================================
# grove doctor — verify dependencies and wiring
# =============================================================================
grove_doctor() {
  local ok=0
  _chk() { # name  test-cmd  hint
    if eval "$2" >/dev/null 2>&1; then
      printf '  %s✓%s %s\n' "$_c_grn" "$_c_rst" "$1"
    else
      printf '  %s✗%s %s %s(%s)%s\n' "$_c_red" "$_c_rst" "$1" "$_c_dim" "$3" "$_c_rst"
      ok=1
    fi
  }
  # Resolve the agent command the same way grove go does (config + GROVE_COMMAND),
  # loading the repo's config layers when run inside a worktree.
  local agent_cmd
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && grove_config_load "$(git rev-parse --show-toplevel)"
  agent_cmd=$(grove_config_get "agent.command" GROVE_COMMAND); agent_cmd=${agent_cmd:-claude}

  printf '%sgrove doctor%s (v%s)\n' "$_c_bld" "$_c_rst" "$GROVE_VERSION"
  printf '\n%sRequired:%s\n' "$_c_bld" "$_c_rst"
  _chk "worktrunk (wt)" "command -v wt"                 "brew install worktrunk"
  _chk "cmux CLI"        "grove_cmux"                    "install cmux.app from cmux.dev"
  _chk "jq"              "command -v jq"                  "brew install jq"
  _chk "git"             "command -v git"                "xcode-select --install"
  _chk "agent ($agent_cmd)" "command -v $agent_cmd"      "install it (or set agent.command / GROVE_COMMAND)"
  printf '\n%sOptional:%s\n' "$_c_bld" "$_c_rst"
  _chk "direnv (multi-account)" "command -v direnv"       "brew install direnv"
  _chk "cmux Claude plugin"     "test -n \"\$(wt config show 2>/dev/null | grep -i 'Plugin installed')\"" \
                                "wt config plugins claude install"
  _chk "wt go alias"            "wt config show 2>/dev/null | grep -qE '^\s*go\s*='" \
                                "grove init"

  # Configured sync.paths — the same rows `grove sync list` prints (a
  # misconfigured path fails the doctor; mere divergence doesn't, that's what
  # `grove sync check` is for).
  local sync_n=0 main="" wtroot=""
  main=$(git rev-parse --git-common-dir 2>/dev/null) \
    && main=$(dirname "$(cd "$main" && pwd -P)")
  wtroot=$(git rev-parse --show-toplevel 2>/dev/null) \
    && wtroot=$(cd "$wtroot" && pwd -P)
  [ -n "$wtroot" ] && grove_sync_resolve_paths "$wtroot" "$main"
  sync_n=${#GROVE_SYNC_PATHS[@]}
  if [ "$sync_n" != 0 ]; then
    printf '\n%sSynced paths%s %s(from %s)%s\n' \
      "$_c_bld" "$_c_rst" "$_c_dim" "${main:-?}" "$_c_rst"
    grove_sync_list "$main" "$wtroot" || ok=1
  fi

  [ -n "${CMUX_WORKSPACE_ID:-}" ] \
    && printf '\n%s✓ running inside cmux%s (window targeting works)\n' "$_c_grn" "$_c_rst" \
    || printf '\n%s!%s not inside a cmux workspace — %sgrove go%s targets cmux best when run from a cmux tab\n' \
         "$_c_ylw" "$_c_rst" "$_c_bld" "$_c_rst"
  return $ok
}

# =============================================================================
# grove init [--with-multi-account] — optional wiring
# =============================================================================
GROVE_CONFIG="${WORKTRUNK_CONFIG:-$HOME/.config/worktrunk/config.toml}"

grove_init() {
  local want_multi=0
  for a in "$@"; do
    case "$a" in
      --with-multi-account) want_multi=1 ;;
      -h|--help) echo "usage: grove init [--with-multi-account]"; return 0 ;;
      *) die "grove init: unknown option '$a'" ;;
    esac
  done

  command -v wt >/dev/null 2>&1 || die "worktrunk (wt) required first — see 'grove doctor'"
  mkdir -p "$(dirname "$GROVE_CONFIG")"
  [ -f "$GROVE_CONFIG" ] || { warn "no worktrunk config; creating one"; wt config create >/dev/null 2>&1 || true; }
  touch "$GROVE_CONFIG"

  # 1. cmux Claude plugin (activity markers + statusline source).
  if wt config show 2>/dev/null | grep -qi "Plugin installed"; then
    info "cmux Claude plugin already installed"
  else
    info "installing cmux Claude plugin…"
    if wt config plugins claude install --yes >/dev/null 2>&1; then
      info "  done"
    else
      warn "  skipped (install manually: wt config plugins claude install)"
    fi
  fi

  # 2. wt go alias (sugar for `grove go`).
  if grep -qE '^\s*go\s*=' "$GROVE_CONFIG"; then
    info "'wt go' alias already present"
  else
    info "adding 'wt go' alias to $GROVE_CONFIG"
    if grep -qE '^\s*\[aliases\]' "$GROVE_CONFIG"; then
      # append under existing [aliases]
      awk '1; /^\[aliases\]/ && !done { print "go = \"grove go {{ args[0] }} {{ args[1:] | join('"'"' '"'"') }}\""; done=1 }' \
        "$GROVE_CONFIG" > "$GROVE_CONFIG.tmp" && mv "$GROVE_CONFIG.tmp" "$GROVE_CONFIG"
    else
      printf '\n[aliases]\ngo = "grove go {{ args[0] }} {{ args[1:] | join('"'"' '"'"') }}"\n' >> "$GROVE_CONFIG"
    fi
  fi

  # 3. Optional multi-account direnv hook.
  if [ "$want_multi" = 1 ]; then
    if grep -qE '^\s*gh-account\s*=' "$GROVE_CONFIG"; then
      info "multi-account hook already present"
    elif ! command -v direnv >/dev/null 2>&1; then
      warn "multi-account requested but direnv not found; skipping (brew install direnv)"
    else
      info "adding multi-account pre-start hook"
      cat >> "$GROVE_CONFIG" <<'TOML'

# grove: per-worktree GH_CONFIG_DIR inherited from the main checkout's direnv.
[pre-start]
gh-account = """
ghdir=$(direnv exec {{ primary_worktree_path }} sh -c 'printf %s "$GH_CONFIG_DIR"')
if [ -n "$ghdir" ]; then
  printf 'export GH_CONFIG_DIR=%s\n' "$ghdir" > {{ worktree_path }}/.envrc
  direnv allow {{ worktree_path }}
fi
"""
TOML
    fi
  fi

  # 4. Gitignore the personal config override, if run inside a repo. The
  #    committed .grove.json is repo identity; .grove.local.json is per-machine.
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local top gi
    top=$(git rev-parse --show-toplevel)
    gi="$top/.gitignore"
    if git -C "$top" check-ignore -q .grove.local.json; then
      info ".grove.local.json already gitignored"
    else
      info "adding .grove.local.json to ${gi#"$top"/}"
      # preserve a final newline: if the file lacks a trailing one, add it first
      [ -s "$gi" ] && [ -n "$(tail -c1 "$gi")" ] && printf '\n' >> "$gi"
      printf '%s\n' ".grove.local.json" >> "$gi"
    fi
  fi

  info "init complete — try: ${_c_bld}grove go feature/test draft a hello-world${_c_rst}"
  [ "$want_multi" = 1 ] || info "multi-account direnv inheritance available via ${_c_bld}grove init --with-multi-account${_c_rst}"
}

# ---- dispatch ---------------------------------------------------------------
grove_usage() {
  cat <<EOF
${_c_bld}grove${_c_rst} v$GROVE_VERSION — parallel Claude agents in worktrees, grouped in cmux

${_c_bld}Usage:${_c_rst}
  grove go [--base <ref>] [--no-fetch] <branch> [prompt...]
                                  Create a worktree + spawn a cmux Claude agent.
                                  New branches fetch and branch from origin/<default>
                                  by default; --base <ref> overrides the base (e.g.
                                  @ for current HEAD), --no-fetch stays offline.
  grove rm [--force] [-D] [--keep-branch] [--reap] [--no-fetch] [<branch>]
                                  Tear down a worktree you're done with: close its
                                  cmux workspace and 'wt remove' the worktree
                                  (defaults to the current branch). Safe by default —
                                  refuses a dirty tree without --force, and deletes
                                  the branch only if merged (squash-aware; fetches
                                  origin/<default> first so a fresh squash-merge
                                  counts — --no-fetch skips). -D force-deletes an
                                  unmerged branch, --keep-branch always keeps it.
                                  If the tab anchors its cmux group, the group is
                                  re-anchored to the repo header first (a group is
                                  never dissolved; refuses to close on failure).
  grove sync [list|check|add|rm]  Manage the untracked paths carried into worktrees
                                  (sync.paths — .env & friends). Bare 'sync' fills the
                                  gaps in both directions: missing here are copied from
                                  the main checkout, missing there are seeded from this
                                  worktree, and a .env both sides have gets its keys
                                  merged (a key with two different values is left alone
                                  and exits 1). Nothing is ever overwritten.
                                  'check' diffs them against the main checkout and
                                  exits 1 if any differ (what 'grove rm' guards on);
                                  'list' shows each path's config + worktree state;
                                  'add'/'rm [--local] <path>...' edit .grove.json
                                  (--local writes .grove.local.json instead).
  grove restyle [--color C] [--icon S]   Re-apply this repo's group color/icon
  grove init [--with-multi-account]   Optional wiring (alias, cmux plugin, direnv)
  grove doctor                    Check dependencies and wiring
  grove version

${_c_bld}Config (layered, low → high precedence):${_c_rst}
  \${XDG_CONFIG_HOME:-~/.config}/grove/config.json   machine-wide defaults
  <repo-root>/.grove.json                           committed, repo-shared
  <repo-root>/.grove.local.json                     gitignored, personal
  Files deep-merge (last layer wins per key). Repo files are read from the
  worktree you run grove in, so styling is committable on your branch.

${_c_bld}Per-repo styling${_c_rst} (any of the layers above):
  color: #RRGGBB | "auto" (deterministic from repo name) | "inherit" (clear)
  icon:  an SF Symbol name (e.g. "leaf.fill"); omit to clear (use byCwd/default)
  restyle --color random stamps a random palette color; --icon none drops the icon

${_c_bld}Per-repo agent${_c_rst} (any of the layers above):
  agent.command  executable to launch (default: claude; env GROVE_COMMAND wins)
  agent.args     array of argv tokens passed before the prompt (default: none)

${_c_bld}Synced untracked paths${_c_rst} (any of the layers above):
  sync.paths     array of repo-relative gitignored files/dirs (e.g. [".env"])
                 copied from the main checkout into each new worktree. An
                 existing file is never overwritten, and only gitignored paths
                 sync (anything git tracks or would report as untracked would
                 leave the worktree dirty and block 'wt remove'). 'grove doctor'
                 lists them. Before removing a worktree, 'grove rm' diffs each one
                 against the main checkout and refuses if any differs — so a
                 secret written only in the worktree is never deleted unseen;
                 --force removes anyway. Manage all of it with 'grove sync'.

${_c_bld}Env:${_c_rst}
  GROVE_COMMAND command to launch (overrides agent.command; default: claude)
  GROVE_CMUX    path to the cmux CLI (default: auto-detect)

${_c_bld}Workspace env stamp${_c_rst} (written into each workspace grove go creates):
  GROVE_WORKTREE_PATH / GROVE_REPO_PATH / GROVE_VERSION — identity stamped at
  create; every shell in the tab inherits them, and grove's matchers fall back
  to the worktree path when a tab/branch rename defeats the title match.
EOF
}

main() {
  [ "${BASH_VERSINFO[0]:-0}" -ge 4 ] \
    || die "grove needs bash 4+ (running ${BASH_VERSION:-unknown}) — 'brew install bash'"
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    go)            grove_go "$@" ;;
    rm)            grove_rm "$@" ;;
    sync)          grove_sync "$@" ;;
    restyle)       grove_restyle "$@" ;;
    init)          grove_init "$@" ;;
    doctor)        grove_doctor "$@" ;;
    version|--version|-V) echo "grove v$GROVE_VERSION" ;;
    help|--help|-h|"") grove_usage ;;
    *) err "unknown command '$cmd'"; grove_usage; exit 1 ;;
  esac
}

# Run only when executed, not when sourced (tests source for unit checks).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
